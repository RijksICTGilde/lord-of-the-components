{% import 'components/_generic_attributes.j2' as attrs %}
{% macro lotc_render(_component_context) %}
{% set gap = _component_context.get('gap', '') %}
{% set justify = _component_context.get('justify', '') %}
{% set align = _component_context.get('align', '') %}
{% set cls = ['lotc-cluster'] %}
{% if justify %}{% set cls = cls + ['lotc-cluster--justify-' ~ justify] %}{% endif %}
{% if align %}{% set cls = cls + ['lotc-cluster--align-' ~ align] %}{% endif %}
{% if _component_context.get('class') %}{% set cls = cls + _component_context['class'].split() %}{% endif %}
<div class="{{ cls | join(' ') }}" data-lotc-component="cluster" {{ attrs.render_extra_attributes(_component_context) }}
  {% if gap %}style="--lotc-cluster-gap: {{ attrs.space(gap) }};"{% endif %}>
  {{ _component_context.get('content', '') | safe }}
</div>
{% endmacro %}
