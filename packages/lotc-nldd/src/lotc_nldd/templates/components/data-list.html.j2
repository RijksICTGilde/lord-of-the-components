{% import 'components/_generic_attributes.j2' as attrs %}
{#
  NLDD data-list — term/description pairs on one grid, so descriptions line up
  across rows. Markup only; the styling lives in static/lotc/nldd/lotc-nldd.css
  (it used to be a <style> block here, repeated per instance).
#}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set content = c.get('content', '') %}
{% set cls = c.get('class', '') %}
<dl class="lotc-data-list {{ cls }}" data-lotc-component="data-list" {{ attrs.render_extra_attributes(c) }}>
{{ content | safe }}
</dl>
{% endmacro %}
