{% import 'components/_generic_attributes.j2' as attrs %}
{% macro lotc_render(_component_context) %}
{% set label = _component_context.get('label', '') %}
{% set href = _component_context.get('href', '') %}
<nldd-breadcrumbs-item text="{{ label }}"{% if href %} href="{{ href }}"{% endif %} data-lotc-component="breadcrumbs-item" {{ attrs.render_extra_attributes(_component_context) }}></nldd-breadcrumbs-item>
{% endmacro %}
