{% import 'components/_generic_attributes.j2' as attrs %}
{#
  NLDD secret-field — hand-authored display component. Shows a secret masked,
  with a reveal toggle (eye / eye-slash) and an optional copy button (clipboard).
  Self-contained: scoped CSS + one delegated click handler, initialised once so N
  instances on a page share it. The value lives in a data attribute (it is an
  already-existing secret being displayed, unmasked only client-side on reveal).
#}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set value = c.get('value', '') %}
{% set mask_length = c.get('mask-length', '12') %}
{% set show_copy = c.get('show-copy', false) %}
{% set width = c.get('content-width', '') %}
{% set vtype = c.get('value-type', 'text') %}
{% set revealed = c.get('revealed', false) %}
{% set cls = c.get('class', '') %}
<div class="lotc-secret {{ cls }}" data-lotc-component="secret-field"{% if width %} style="max-width: {{ width }}"{% endif %} {{ attrs.render_extra_attributes(c) }}>
  <code class="lotc-secret__value{% if vtype == 'json' %} lotc-secret__value--json{% endif %}{% if revealed %} is-shown{% endif %}" data-value="{{ value | e }}" data-mask="{{ mask_length }}" aria-label="{{ 'Waarde' if revealed else 'Afgeschermde waarde' }}">{% if revealed %}{{ value }}{% else %}{{ '•' * (mask_length | int) }}{% endif %}</code>
  {% if not revealed %}<button type="button" class="lotc-secret__btn" data-act="reveal" aria-pressed="false" aria-label="Tonen" title="Tonen"><nldd-icon name="eye" size="20"></nldd-icon></button>{% endif %}
  {% if show_copy %}<button type="button" class="lotc-secret__btn" data-act="copy" aria-label="Kopieren" title="Kopieren"><nldd-icon name="clipboard" size="20"></nldd-icon></button>{% endif %}
</div>
<style>
.lotc-secret{display:inline-flex;align-items:center;gap:.25rem;border:1px solid var(--nldd-color-border,var(--semantics-dividers-color,#b3b3b3));border-radius:6px;padding:.2rem .5rem;background:var(--nldd-color-surface,var(--semantics-surfaces-base-background-color,#fff));color:var(--nldd-color-text,var(--semantics-content-color,#1a1a1a));max-width:100%}
.lotc-secret__value{font-family:ui-monospace,'Courier New',monospace;font-size:.875rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1 1 auto;min-width:0}
.lotc-secret__value--json.is-shown{white-space:pre-wrap;word-break:break-all}
.lotc-secret__btn{display:inline-flex;align-items:center;justify-content:center;border:0;background:none;cursor:pointer;padding:.15rem;border-radius:4px;color:var(--nldd-color-accent,var(--semantics-content-accent-color,#154273));flex:0 0 auto}
.lotc-secret__btn:hover{background:var(--nldd-color-surface-tinted,var(--semantics-surfaces-tinted-background-color,rgba(0,0,0,.06)))}
</style>
<script>
(function(){if(window.__lotcSecretInit)return;window.__lotcSecretInit=1;
document.addEventListener('click',function(e){
  var b=e.target.closest('.lotc-secret__btn');if(!b)return;
  var box=b.closest('.lotc-secret'),v=box&&box.querySelector('.lotc-secret__value');if(!v)return;
  if(b.dataset.act==='reveal'){
    var shown=box.classList.toggle('is-shown');
    b.setAttribute('aria-pressed',shown?'true':'false');
    b.setAttribute('title',shown?'Verbergen':'Tonen');
    var ic=b.querySelector('nldd-icon');if(ic)ic.setAttribute('name',shown?'eye-slash':'eye');
    v.textContent=shown?v.dataset.value:'•'.repeat(parseInt(v.dataset.mask||'12',10));
  }else if(b.dataset.act==='copy'){
    if(navigator.clipboard)navigator.clipboard.writeText(v.dataset.value);
    b.setAttribute('title','Gekopieerd');setTimeout(function(){b.setAttribute('title','Kopieren');},1200);
  }
});})();
</script>
{% endmacro %}
