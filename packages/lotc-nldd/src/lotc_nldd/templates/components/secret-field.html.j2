{% import 'components/_generic_attributes.j2' as attrs %}
{#
  NLDD secret-field — hand-authored display component. Shows a secret masked,
  with a reveal toggle (eye / eye-slash) and an optional copy button (clipboard).

  Markup only: the styling lives in static/lotc/nldd/lotc-nldd.css and the
  behaviour in lotc-nldd.js, both loaded once per page by the design system.
  They used to be a <style> and a <script> in here, which meant one copy per
  instance on the page and no way to run under a CSP without 'unsafe-inline'.

  The server renders the masked value, so the field reads correctly before (and
  without) JavaScript; the element only takes over toggling. `revealed` is an
  attribute on the host, which is what both the CSS and the element read.

  The value lives in an attribute (it is an already-existing secret being
  displayed, unmasked only client-side on reveal).
#}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set value = c.get('value', '') %}
{% set mask_length = c.get('mask-length', '12') %}
{% set show_copy = c.get('show-copy', false) %}
{% set width = c.get('content-width', '') %}
{% set vtype = c.get('value-type', 'text') %}
{% set revealed = c.get('revealed', false) %}
{% set cls = c.get('class', '') %}
<lotc-secret-field{% if cls %} class="{{ cls }}"{% endif %} data-lotc-component="secret-field" value="{{ value | e }}" mask-length="{{ mask_length }}"{% if vtype != 'text' %} value-type="{{ vtype }}"{% endif %}{% if revealed %} revealed{% endif %}{% if width %} style="max-width: {{ width }}"{% endif %} {{ attrs.render_extra_attributes(c) }}>
  <code aria-label="{{ 'Waarde' if revealed else 'Afgeschermde waarde' }}">{% if revealed %}{{ value }}{% else %}{{ '•' * (mask_length | int) }}{% endif %}</code>
  {% if not revealed %}<button type="button" data-action="reveal" aria-pressed="false" aria-label="Tonen" title="Tonen"><nldd-icon name="eye" size="20"></nldd-icon></button>{% endif %}
  {% if show_copy %}<button type="button" data-action="copy" aria-label="Kopieren" title="Kopieren"><nldd-icon name="clipboard" size="20"></nldd-icon></button>{% endif %}
</lotc-secret-field>
{% endmacro %}
