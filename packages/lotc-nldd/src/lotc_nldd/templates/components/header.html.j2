{% import 'components/_generic_attributes.j2' as attrs %}
{% set children = _component_context.get('content', '') %}
{% set slots = _component_context.get('slots', {}) %}
{% set link = _component_context.get('link', '#') %}
{% set subtitle = _component_context.get('subtitle', '') %}
{% set text = _component_context.get('text', '') %}
{% set css_classes = [] %}
{% if _component_context.get('class') %}
    {% set css_classes = css_classes + _component_context['class'].split() %}
{% endif %}
<nldd-top-navigation-bar
    class="{{ css_classes | join(' ') }}"
    data-lotc-component="header"
    {% if text %}logo-title="{{ text }}"{% endif %}
    {% if subtitle %}logo-subtitle="{{ subtitle }}"{% endif %}
    {% if link %}website-href="{{ link }}"{% endif %}
    {{ attrs.render_extra_attributes(_component_context) }}>
    {{ children | safe }}
</nldd-top-navigation-bar>
