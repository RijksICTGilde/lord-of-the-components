# Lord of the Components - Header Component Logic
# Page header section with logo, navigation, and actions

render.element("header"):
    # Base class
    attrs.class = "c-header"

    # Sticky modifier for fixed positioning
    if props.sticky:
        attrs.class = attrs.class + " c-header--sticky"

    # Bordered modifier (default true, so check for explicit false)
    if props.bordered == false:
        attrs.class = attrs.class + " c-header--no-border"

    # Max width modifier
    if props.maxWidth:
        attrs.class = attrs.class + " c-header--max-" + props.maxWidth

    # Inner container for content alignment
    render.element("div"):
        attrs.class = "c-header__inner"

        # Logo section (left)
        if slots.logo:
            render.element("div"):
                attrs.class = "c-header__logo"
                render.slot("logo")

        # Navigation section (center/main)
        if slots.nav:
            render.element("nav"):
                attrs.class = "c-header__nav"
                render.slot("nav")

        # Default slot for flexible content
        if slots.default:
            render.element("div"):
                attrs.class = "c-header__content"
                render.slot("default")

        # Actions section (right)
        if slots.actions:
            render.element("div"):
                attrs.class = "c-header__actions"
                render.slot("actions")
