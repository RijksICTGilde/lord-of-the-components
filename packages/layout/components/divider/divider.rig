# Lord of the Components - Divider Component Logic
# Visual separator line between content

# Labeled divider uses div with role="separator"
if props.label or slots.default:
    render.element("div"):
        attrs.role = "separator"
        attrs.orientation = props.orientation
        attrs.spacing = props.spacing
        if props.color:
            attrs.color = props.color

        # Label text
        render.element("span"):
            attrs.class = "c-divider__label"
            if props.label:
                render.text(props.label)
            else:
                render.slot("default")

# Simple divider uses hr element
else:
    render.element("hr"):
        attrs.orientation = props.orientation
        attrs.spacing = props.spacing
        if props.color:
            attrs.color = props.color
