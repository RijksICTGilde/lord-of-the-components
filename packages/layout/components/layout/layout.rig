# Lord of the Components - Layout Component Logic
# Main layout container with optional sidebar, header, and footer regions

render.element("div"):
    # Layout variant
    attrs.variant = props.variant

    # Max width constraint
    attrs.maxWidth = props.maxWidth

    # Spacing
    attrs.padding = props.padding
    attrs.gap = props.gap

    # Header region (above main content)
    if props.header:
        render.element("header"):
            attrs.class = "c-layout__header"
            render.slot("header")

    # Middle section (sidebar + main or just main)
    render.element("div"):
        attrs.class = "c-layout__middle"

        # Sidebar (left position for sidebar-left and holy-grail variants)
        if props.sidebar and (props.variant == "sidebar-left" or props.variant == "holy-grail"):
            render.element("aside"):
                attrs.class = "c-layout__sidebar"
                render.slot("sidebar")

        # Main content area
        render.element("main"):
            attrs.class = "c-layout__main"
            render.slot("default")

        # Sidebar (right position for sidebar-right variant)
        if props.sidebar and props.variant == "sidebar-right":
            render.element("aside"):
                attrs.class = "c-layout__sidebar"
                render.slot("sidebar")

    # Footer region (below main content)
    if props.footer:
        render.element("footer"):
            attrs.class = "c-layout__footer"
            render.slot("footer")
