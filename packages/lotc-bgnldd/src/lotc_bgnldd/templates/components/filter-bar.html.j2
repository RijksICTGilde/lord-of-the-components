{% import 'components/_generic_attributes.j2' as attrs %}
{% macro lotc_render(_component_context) %}
{% set placeholder = _component_context.get("placeholder", "") %}
{% set search_label = _component_context.get("search-label", "Zoeken") %}
{% set count = _component_context.get("count", "") %}
{% set clear_label = _component_context.get("clear-label", "") %}
{% set children = _component_context.get("content", "") %}
<nldd-card data-lotc-component="filter-bar" {{ attrs.render_extra_attributes(_component_context) }}><nldd-container padding="20">
  <div class="lotc-filterbar">
    <div class="lotc-filter-search">
      {% if search_label %}<span class="lotc-filter-label">{{ search_label }}</span>{% endif %}
      <div class="lotc-filter-searchbox">{{ _lotc_nldd_icon(icon="search") }}<input type="search" class="lotc-filter-input" placeholder="{{ placeholder }}" aria-label="{{ search_label }}"></div>
    </div>
    {% if children %}<div class="lotc-filter-fields">{{ children | safe }}</div>{% endif %}
  </div>
  {% if count or clear_label %}<div class="lotc-filter-foot">
    {% if count %}<span class="lotc-filter-count">{{ count }}</span>{% endif %}
    {% if clear_label %}<button type="button" class="lotc-filter-clear"><span aria-hidden="true">&#10005;</span> {{ clear_label }}</button>{% endif %}
  </div>{% endif %}
</nldd-container></nldd-card>
{% endmacro %}
