{% set title = _component_context.get('title', '') %}
{% set icon = _component_context.get('icon', '') %}
{% set children = _component_context.get('content', '') %}
<div class="bg-section-head" data-lotc-component="section-head">
    {% if title %}<nldd-title size="4"><h2 class="bg-section-title">{{ title }}</h2></nldd-title>{% endif %}
    {% if icon or children %}<div class="bg-section-head-aside">{{ children | safe }}{% if icon %}{{ _lotc_nldd_icon(icon=icon, _class='bg-head-icon') }}{% endif %}</div>{% endif %}
</div>
