{% import 'components/_generic_attributes.j2' as attrs %}
{% macro lotc_render(_component_context) %}
{% set title = _component_context.get('title', '') %}
{% set icon = _component_context.get('icon', '') %}
{% set children = _component_context.get('content', '') %}
<div class="lotc-section-head" data-lotc-component="section-head" {{ attrs.render_extra_attributes(_component_context) }}>
    {% if title %}<nldd-title size="4"><h2 class="lotc-section-title">{{ title }}</h2></nldd-title>{% endif %}
    {% if icon or children %}<div class="lotc-section-head-aside">{{ children | safe }}{% if icon %}{{ _lotc_nldd_icon(icon=icon, _class='lotc-head-icon') }}{% endif %}</div>{% endif %}
</div>
{% endmacro %}
