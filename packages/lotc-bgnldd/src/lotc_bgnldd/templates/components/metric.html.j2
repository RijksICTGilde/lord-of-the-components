{% set icon = _component_context.get('icon', '') %}
{% set value = _component_context.get('value', '') %}
{% set label = _component_context.get('label', '') %}
{% set sub = _component_context.get('sub', '') %}
{% set href = _component_context.get('href', '') %}
{% set extra = _component_context.get('class', '') %}
<a{% if href %} href="{{ href }}"{% endif %} class="bg-metric-link{% if extra %} {{ extra }}{% endif %}" data-lotc-component="metric">
    <nldd-card accessible-label="{{ label }}">
        <nldd-container padding="20">
            <div class="bg-metric-top">{% if icon %}{{ _lotc_nldd_icon(icon=icon) }}{% endif %}<span class="bg-metric-value">{{ value }}</span></div>
            <div class="bg-metric-label">{{ label }}</div>
            {% if sub %}<div class="bg-metric-sub">{{ sub }}</div>{% endif %}
        </nldd-container>
    </nldd-card>
</a>
