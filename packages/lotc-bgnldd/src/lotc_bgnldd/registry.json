        {
          "name": "icon",
          "type": "string",
          "description": "Icon name (semantic)"
        },
        {
          "name": "value",
          "type": "string",
          "description": "The metric value (e.g. \"244\")"
        },
        {
          "name": "label",
          "type": "string",
          "description": "Metric label (e.g. \"Datacenters\")"
        },
        {
          "name": "sub",
          "type": "string",
          "description": "Sub-line under the label (e.g. \"4 operationeel\")"
        },
        {
          "name": "href",
          "type": "string",
          "description": "Link target for the whole card"
        },
        {
          "name": "class",
          "type": "string",
          "description": "Additional CSS classes"
        }
      ],
      "description": "Stat/metric card link: icon + value, with a label and sub-line",
      "category": "data-display",
      "backend": "jinja"
    },
