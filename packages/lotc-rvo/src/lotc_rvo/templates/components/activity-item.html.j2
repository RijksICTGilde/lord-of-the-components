{% macro lotc_render(_component_context) %}
{% set icon = _component_context.get("icon", "") %}
{% set actor = _component_context.get("actor", "") %}
{% set action = _component_context.get("action", "") %}
{% set res = _component_context.get("res", "") %}
{% set at = _component_context.get("at", "") %}
{% set href = _component_context.get("href", "") %}
<li class="lotc-activity-item" data-lotc-component="activity-item">
  <span class="lotc-activity-dot">{% if icon %}{{ _lotc_rvo_icon(icon=icon, size="sm") }}{% endif %}</span>
  <span class="lotc-activity-body">
    <span class="lotc-activity-line">{% if href %}<a href="{{ href }}" class="lotc-activity-actor">{{ actor }}</a>{% else %}<span class="lotc-activity-actor">{{ actor }}</span>{% endif %} <span class="lotc-activity-action">{{ action }}</span></span>
    <span class="lotc-activity-meta">{% if res %}<span class="lotc-activity-res">{{ res }}</span>{% endif %}{% if at %}<span class="lotc-activity-at">{{ at }}</span>{% endif %}</span>
  </span>
</li>
{% endmacro %}
