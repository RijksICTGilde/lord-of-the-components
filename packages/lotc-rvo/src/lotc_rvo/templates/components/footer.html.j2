{% import 'components/_generic_attributes.j2' as attrs %}
{% set children = _component_context.get('content', '') %}
{% set slots = _component_context.get('slots', {}) %}
{% set max_width = _component_context.get('max-width', '') %}
{% set pay_off = _component_context.get('pay-off', '') %}
{% set css_classes = ['rvo-footer'] %}
{% if _component_context.get('class') %}
    {% set css_classes = css_classes + _component_context['class'].split() %}
{% endif %}
<footer
    class="{{ css_classes | join(' ') }}"
    data-lotc-component="footer"
    {{ attrs.render_extra_attributes(_component_context) }}>
    {% set css_classes = ['rvo-footer__container'] %}
    {% if max_width == 'sm' %}{% set css_classes = css_classes + ['rvo-footer__container--sm'] %}{% endif %}
    {% if max_width == 'md' %}{% set css_classes = css_classes + ['rvo-footer__container--md'] %}{% endif %}
    {% if max_width == 'lg' %}{% set css_classes = css_classes + ['rvo-footer__container--lg'] %}{% endif %}
    <div
        class="{{ css_classes | join(' ') }}">
        {% if children %}
        <span>{{ children | safe }}</span>
        {% endif %}
        {% if pay_off %}
        {% set css_classes = ['rvo-footer__payoff'] %}
        <div
            class="{{ css_classes | join(' ') }}">
            {{ pay_off }}
        </div>
        {% endif %}
    </div>
</footer>
