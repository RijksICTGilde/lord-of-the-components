{% import 'components/_forms.j2' as f %}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set id = c.get('id', '') %}{% set name = c.get('name', '') %}{% set label = c.get('label', '') %}
{% set help = c.get('help', '') %}{% set error = c.get('error', '') %}
{% set required = c.get('required', false) %}{% set disabled = c.get('disabled', false) %}
{% set value = c.get('value', '') %}{% set min = c.get('min', '') %}{% set max = c.get('max', '') %}
{% set db = f.describedby(id, help, error) %}
{% if 'nldd' in lotc_design_systems %}
{% call f.nldd_field(id, label, help, error, required, 'date-input-field') %}
<nldd-date-field input-id="{{ id }}" name="{{ name }}"{% if value %} value="{{ value }}"{% endif %}{% if min %} min="{{ min }}"{% endif %}{% if max %} max="{{ max }}"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if error %} invalid unmet="{{ id }}-error"{% endif %}{{ f.render_attrs(c) }}></nldd-date-field>
{% endcall %}
{% else %}
{% call f.rvo_field(id, label, help, error, required, 'date-input-field') %}
<input id="{{ id }}" name="{{ name }}" type="date" value="{{ value }}"{% if min %} min="{{ min }}"{% endif %}{% if max %} max="{{ max }}"{% endif %} class="utrecht-textbox utrecht-textbox--html-input{% if error %} utrecht-textbox--invalid{% endif %}"{% if db %} aria-describedby="{{ db }}"{% endif %}{% if error %} aria-invalid="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{{ f.render_attrs(c) }} />
{% endcall %}
{% endif %}
{% endmacro %}
