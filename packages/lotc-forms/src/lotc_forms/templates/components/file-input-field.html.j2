{% import 'components/_forms.j2' as f %}
{# NLDD has no native file field (confirmed absent from the NLDD manifest), so
   this always renders the RVO/native file input; under NLDD it adds a visible
   fallback badge rather than dropping the field. #}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set id = c.get('id', '') %}{% set name = c.get('name', '') %}{% set label = c.get('label', '') %}
{% set help = c.get('help', '') %}{% set error = c.get('error', '') %}
{% set required = c.get('required', false) %}{% set disabled = c.get('disabled', false) %}
{% set accept = c.get('accept', '') %}{% set multiple = c.get('multiple', false) %}
{% set db = f.describedby(id, help, error) %}
{% call f.rvo_field(id, label, help, error, required, 'file-input-field') %}
<input id="{{ id }}" name="{{ name }}" type="file"{% if accept %} accept="{{ accept }}"{% endif %}{% if multiple %} multiple{% endif %} class="utrecht-textbox utrecht-textbox--html-input rvo-file-input{% if error %} utrecht-textbox--invalid{% endif %}"{% if db %} aria-describedby="{{ db }}"{% endif %}{% if error %} aria-invalid="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %} />
{% if 'nldd' in lotc_design_systems %}<span class="lotc-file-fallback" role="note">RVO-veld (NLDD heeft geen eigen bestandsveld)</span>{% endif %}
{% endcall %}
{% endmacro %}
