{% import 'components/_forms.j2' as f %}
{# NLDD gained a native file field in 0.8.80 (nldd-file-field), so under NLDD this
   now renders the real theme field (no RVO fallback badge); RVO keeps its native
   file input. #}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set id = c.get('id', '') %}{% set name = c.get('name', '') %}{% set label = c.get('label', '') %}
{% set help = c.get('help', '') %}{% set error = c.get('error', '') %}
{% set required = c.get('required', false) %}{% set disabled = c.get('disabled', false) %}
{% set accept = c.get('accept', '') %}{% set multiple = c.get('multiple', false) %}
{% set db = f.describedby(id, help, error) %}
{% if 'nldd' in lotc_design_systems %}
{% call f.nldd_field(id, label, help, error, required, 'file-input-field') %}
<nldd-file-field input-id="{{ id }}" name="{{ name }}"{% if accept %} accept="{{ accept }}"{% endif %}{% if multiple %} multiple{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if error %} invalid unmet="{{ id }}-error"{% endif %}{{ f.render_attrs(c) }}></nldd-file-field>
{% endcall %}
{% else %}
{% call f.rvo_field(id, label, help, error, required, 'file-input-field') %}
<input id="{{ id }}" name="{{ name }}" type="file"{% if accept %} accept="{{ accept }}"{% endif %}{% if multiple %} multiple{% endif %} class="utrecht-textbox utrecht-textbox--html-input rvo-file-input{% if error %} utrecht-textbox--invalid{% endif %}"{% if db %} aria-describedby="{{ db }}"{% endif %}{% if error %} aria-invalid="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{{ f.render_attrs(c) }} />
{% endcall %}
{% endif %}
{% endmacro %}
