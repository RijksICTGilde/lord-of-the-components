{% import 'components/_forms.j2' as f %}
{% macro lotc_render(_component_context) %}
{% set c = _component_context %}
{% set id = c.get('id', '') %}{% set name = c.get('name', '') %}{% set label = c.get('label', '') %}
{% set help = c.get('help', '') %}{% set error = c.get('error', '') %}
{% set required = c.get('required', false) %}{% set checked = c.get('checked', false) %}
{% set value = c.get('value', '') %}{% set content = c.get('content', '') %}
{% set db = f.describedby(id, help, error) %}
{% if content %}
{# a group of <c-checkbox> children, labelled by the field #}
{% if 'nldd' in lotc_design_systems %}
{% call f.nldd_field(id, label, help, error, required, 'checkbox-field') %}<div{{ f.render_attrs(c) }}>{{ content | safe }}</div>{% endcall %}
{% else %}
{% call f.rvo_group(id, label, help, error, required, 'checkbox-field') %}<div class="rvo-checkbox__group{% if error %} rvo-checkbox__group--error{% endif %}"{{ f.render_attrs(c) }}>{{ content | safe }}</div>{% endcall %}
{% endif %}
{% else %}
{# a single checkbox: the control carries the label, help/error below #}
{% if 'nldd' in lotc_design_systems %}
<div class="lotc-checkbox-field" data-lotc-component="checkbox-field">
<nldd-checkbox-field{% if id %} id="{{ id }}"{% endif %} name="{{ name }}"{% if value %} value="{{ value }}"{% endif %} label="{{ label }}"{% if checked %} checked{% endif %}{% if error %} invalid{% endif %}{{ f.render_attrs(c) }}></nldd-checkbox-field>
{% if help %}<nldd-form-field-help-text id="{{ id }}-help">{{ help }}</nldd-form-field-help-text>{% endif %}
{% if error %}<nldd-form-field-error-text id="{{ id }}-error" invalid>{{ error }}</nldd-form-field-error-text>{% endif %}
</div>
{% else %}
<div class="utrecht-form-field rvo-form-field{% if error %} rvo-form-field--error{% endif %}" data-lotc-component="checkbox-field">
<label class="rvo-checkbox{% if checked %} rvo-checkbox--checked{% endif %}">
<input class="rvo-checkbox__input" type="checkbox" id="{{ id }}" name="{{ name }}"{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if required %} required{% endif %}{% if error %} aria-invalid="true"{% endif %}{% if db %} aria-describedby="{{ db }}"{% endif %}{{ f.render_attrs(c) }}>
<span class="rvo-checkbox__label">{{ label }}</span>
</label>
{% if help %}<div class="utrecht-form-field-description" id="{{ id }}-help">{{ help }}</div>{% endif %}
{% if error %}<div class="utrecht-form-field-description utrecht-form-field-description--invalid rvo-form-feedback rvo-form-feedback--error" id="{{ id }}-error">{{ error }}</div>{% endif %}
</div>
{% endif %}
{% endif %}
{% endmacro %}
