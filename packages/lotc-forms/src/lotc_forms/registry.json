{
 "meta": {
  "set": "lotc-forms",
  "note": "Labelled form fields with guaranteed ARIA wiring; renders per active theme."
 },
 "components": [
  {
   "name": "text-input-field",
   "attributes": [
    {
     "name": "id",
     "type": "string",
     "description": "Field id \u2014 drives label for/id and aria-describedby"
    },
    {
     "name": "name",
     "type": "string",
     "description": "Input name"
    },
    {
     "name": "label",
     "type": "string",
     "description": "Field label"
    },
    {
     "name": "type",
     "type": "enum",
     "enum_values": [
      "text",
      "email",
      "tel",
      "url",
      "number",
      "search",
      "date",
      "datetime-local",
      "time",
      "password"
     ],
     "description": "Input type"
    },
    {
     "name": "value",
     "type": "string",
     "description": "Input value"
    },
    {
     "name": "show-copy",
     "type": "boolean",
     "description": "Render the value as a read-only copyable box with an in-field clipboard (matches secret-field); for a value you copy but do not edit"
    },
    {
     "name": "placeholder",
     "type": "string",
     "description": "Placeholder text"
    },
    {
     "name": "autocomplete",
     "type": "string",
     "description": "autocomplete token"
    },
    {
     "name": "help",
     "type": "string",
     "description": "Help text (linked via aria-describedby)"
    },
    {
     "name": "error",
     "type": "string",
     "description": "Error text (sets aria-invalid + aria-describedby)"
    },
    {
     "name": "required",
     "type": "boolean",
     "description": "Required field"
    },
    {
     "name": "disabled",
     "type": "boolean",
     "description": "Disabled field"
    },
    {
     "name": "readonly",
     "type": "boolean",
     "description": "Read-only field"
    },
    {
     "name": "class",
     "type": "string",
     "description": "Extra CSS classes"
    }
   ],
   "description": "Labelled single-line text input with help/error and ARIA wiring",
   "category": "forms",
   "backend": "jinja",
   "content": {
    "allowed": false
   }
  },
