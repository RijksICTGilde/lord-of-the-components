# Lord of the Components - Link Component Logic
# Text link for navigation

render.element("a"):
    # Required href attribute
    attrs.href = props.href

    # Core attributes
    attrs.target = props.target
    attrs.underline = props.underline
    attrs.iconPosition = props.iconPosition

    # External links should open in new tab and have security attributes
    if props.external:
        attrs.external = true
        attrs.rel = "noopener noreferrer"

    # State attributes
    if props.disabled:
        attrs.disabled = true
        attrs["aria-disabled"] = "true"
        attrs.tabindex = "-1"

    # Icon before content
    if props.icon:
        if props.iconPosition == "before":
            render.element("c-icon"):
                attrs.name = props.icon

    # Link text
    render.slot("default")

    # Icon after content (includes external icon)
    if props.icon:
        if props.iconPosition == "after":
            render.element("c-icon"):
                attrs.name = props.icon

    # External link indicator icon
    if props.external:
        render.element("c-icon"):
            attrs.name = "external-link"
            attrs["aria-hidden"] = "true"
