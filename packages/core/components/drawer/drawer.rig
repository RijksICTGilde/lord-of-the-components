# Lord of the Components - Drawer Component Logic
# Slide-out drawer panel with customizable position, size, and slots

# Outer wrapper (only renders when open)
if props.open:
    render.element("div"):
        attrs.class = "c-drawer"

        # Position modifier
        if props.position:
            attrs.class = attrs.class + " c-drawer--" + props.position

        # Size modifier
        if props.size:
            attrs.class = attrs.class + " c-drawer--" + props.size

        # ARIA attributes for accessibility
        attrs.role = "dialog"
        attrs["aria-modal"] = "true"
        if props.title:
            attrs["aria-labelledby"] = "drawer-title"

        # Overlay/backdrop (optional)
        if props.overlay:
            render.element("div"):
                attrs.class = "c-drawer__overlay"
                if props.closeOnOverlay:
                    attrs["data-close-on-click"] = "true"

        # Drawer panel
        render.element("div"):
            attrs.class = "c-drawer__panel"

            # Header
            render.element("div"):
                attrs.class = "c-drawer__header"

                # Custom header slot or default title
                if slots.header:
                    render.slot("header")
                else:
                    if props.title:
                        render.element("h2"):
                            attrs.id = "drawer-title"
                            attrs.class = "c-drawer__title"
                            render.text(props.title)

                # Close button (optional)
                if props.showClose:
                    render.element("button"):
                        attrs.type = "button"
                        attrs.class = "c-drawer__close"
                        attrs["aria-label"] = "Close drawer"
                        render.component("icon", name="close")

            # Body/content
            render.element("div"):
                attrs.class = "c-drawer__body"
                render.slot("default")

            # Footer (optional)
            if slots.footer:
                render.element("div"):
                    attrs.class = "c-drawer__footer"
                    render.slot("footer")
