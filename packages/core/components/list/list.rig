# Lord of the Components - List Component Logic
# List container for items with styling variants

# Determine wrapper element (ordered or unordered)
let tag = props.ordered ? "ol" : "ul"

render.element(tag):
    # Variant styling
    attrs.variant = props.variant

    # Size modifier
    attrs.size = props.size

    # Hoverable items
    if props.hoverable:
        attrs.hoverable = true

    # List items
    render.slot("default")
