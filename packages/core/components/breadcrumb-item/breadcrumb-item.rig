# Lord of the Components - Breadcrumb Item Component Logic
# Single breadcrumb item with optional link

render.element("li"):
    # Base class
    attrs.class = "c-breadcrumb__item"

    # If no href, this is the current page
    if not props.href:
        attrs["aria-current"] = "page"

    # Link or text based on href presence
    if props.href:
        render.element("a"):
            attrs.class = "c-breadcrumb__link"
            attrs.href = props.href
            render.slot("default")
    else:
        render.element("span"):
            attrs.class = "c-breadcrumb__text"
            render.slot("default")
