# Lord of the Components - Progress Component Logic
# Progress bar for task completion with determinate and indeterminate states

render.element("div"):
    # Base class
    attrs.class = "c-progress"

    # Size modifier (default: md)
    if props.size:
        attrs.class = attrs.class + " c-progress--" + props.size

    # Variant/color modifier (default: primary)
    if props.variant:
        attrs.class = attrs.class + " c-progress--" + props.variant

    # Indeterminate modifier
    if props.indeterminate:
        attrs.class = attrs.class + " c-progress--indeterminate"

    # ARIA attributes for accessibility
    attrs.role = "progressbar"
    if props.label:
        attrs["aria-label"] = props.label

    # For determinate progress, set ARIA value attributes
    if not props.indeterminate:
        attrs["aria-valuenow"] = props.value
        attrs["aria-valuemin"] = 0
        attrs["aria-valuemax"] = props.max or 100

    # Progress bar track (background)
    render.element("div"):
        attrs.class = "c-progress__track"

        # Progress bar fill (actual progress indicator)
        render.element("div"):
            attrs.class = "c-progress__fill"

            # Set width based on percentage (only for determinate)
            if not props.indeterminate:
                let percentage = (props.value / (props.max or 100)) * 100
                attrs.style = "width: " + percentage + "%"

    # Optional percentage text display
    if props.showValue and not props.indeterminate:
        render.element("span"):
            attrs.class = "c-progress__value"
            let percentage = (props.value / (props.max or 100)) * 100
            render.text(percentage + "%")
