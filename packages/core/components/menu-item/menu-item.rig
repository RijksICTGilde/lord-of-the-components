# Lord of the Components - Menu Item Component Logic
# Single menu item

# Determine element type (link or button)
let tag = props.href ? "a" : "button"

render.element(tag):
    # Base class
    attrs.class = "c-menu__item"
    attrs.role = "menuitem"

    # Link or button specific attributes
    if props.href:
        attrs.href = props.href
    else:
        attrs.type = "button"

    # Destructive styling
    if props.destructive:
        attrs.class = attrs.class + " c-menu__item--destructive"

    # Disabled state
    if props.disabled:
        attrs.class = attrs.class + " c-menu__item--disabled"
        attrs["aria-disabled"] = "true"
        if not props.href:
            attrs.disabled = true

    # Icon (optional)
    if props.icon:
        render.element("span"):
            attrs.class = "c-menu__icon"
            render.component("icon", name=props.icon)

    # Label content wrapper
    render.element("span"):
        attrs.class = "c-menu__content"

        # Primary label
        render.element("span"):
            attrs.class = "c-menu__label"
            render.slot("default")

        # Description slot (optional secondary text)
        if slots.description:
            render.element("span"):
                attrs.class = "c-menu__description"
                render.slot("description")
