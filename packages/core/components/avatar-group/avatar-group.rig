# Lord of the Components - Avatar Group Component Logic
# Stacked group of avatars with optional overflow indicator

render.element("div"):
    # Build CSS classes array
    let classes = ["c-avatar-group"]

    # Size modifier (default: md)
    let size = props.size or "md"
    classes = classes + ["c-avatar-group--" + size]

    # Spacing modifier (default: tight)
    let spacing = props.spacing or "tight"
    classes = classes + ["c-avatar-group--" + spacing]

    # Apply classes
    attrs.class = join(classes, " ")

    # Role for accessibility
    attrs.role = "group"

    # Render children with max limit handling
    if props.max:
        # When max is set, we need to limit visible avatars
        # and show overflow indicator
        render.slot("default")

        # Overflow indicator element (shown via CSS/JS when children exceed max)
        render.element("span"):
            attrs.class = "c-avatar-group__overflow"
            attrs["data-max"] = props.max
            attrs["aria-label"] = "Additional users"

    else:
        # No limit - render all children
        render.slot("default")
