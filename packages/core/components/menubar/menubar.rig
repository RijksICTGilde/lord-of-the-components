# Lord of the Components - Menubar Component Logic
# Horizontal or vertical navigation menu bar

render.element("nav"):
    # Base class
    attrs.class = "c-menubar"

    # Direction modifier
    if props.direction:
        attrs.class = attrs.class + " c-menubar--" + props.direction

    # Size modifier
    if props.size:
        attrs.class = attrs.class + " c-menubar--" + props.size

    # Max width modifier
    if props.maxWidth:
        attrs.class = attrs.class + " c-menubar--max-" + props.maxWidth

    # Show divider modifier
    if props.showDivider:
        attrs.class = attrs.class + " c-menubar--divider"

    # ARIA role for accessibility
    attrs.role = "menubar"

    # Menu list
    render.element("ul"):
        attrs.class = "c-menubar__list"
        attrs.role = "none"

        # Render from items array if provided
        if props.items:
            for index, item in props.items:
                # Divider item
                if item.divider:
                    render.element("li"):
                        attrs.class = "c-menubar__divider"
                        attrs.role = "separator"
                else:
                    render.element("li"):
                        attrs.class = "c-menubar__item"
                        attrs.role = "none"

                        # Alignment modifier
                        if item.align:
                            attrs.class = attrs.class + " c-menubar__item--" + item.align

                        # Link element
                        render.element("a"):
                            attrs.class = "c-menubar__link"
                            attrs.role = "menuitem"
                            attrs.href = item.href or "#"

                            # Active state
                            if item.active:
                                attrs.class = attrs.class + " c-menubar__link--active"
                                attrs["aria-current"] = "page"

                            # Disabled state
                            if item.disabled:
                                attrs.class = attrs.class + " c-menubar__link--disabled"
                                attrs["aria-disabled"] = "true"

                            # Icon (optional)
                            if item.icon:
                                if props.showIcons:
                                    render.element("span"):
                                        attrs.class = "c-menubar__icon"
                                        render.component("icon", name=item.icon)

                            # Label
                            render.element("span"):
                                attrs.class = "c-menubar__label"
                                render.text(item.label)

                            # Submenu indicator
                            if item.submenu:
                                render.element("span"):
                                    attrs.class = "c-menubar__arrow"
                                    attrs["aria-hidden"] = "true"
                                    render.component("icon", name="chevron-down")

                        # Render submenu if present
                        if item.submenu:
                            render.element("ul"):
                                attrs.class = "c-menubar__submenu"
                                attrs.role = "menu"

                                for subIndex, subItem in item.submenu:
                                    render.element("li"):
                                        attrs.class = "c-menubar__item"
                                        attrs.role = "none"

                                        render.element("a"):
                                            attrs.class = "c-menubar__link"
                                            attrs.role = "menuitem"
                                            attrs.href = subItem.href or "#"
                                            render.text(subItem.label)
        else:
            # Slot-based menu items
            render.slot("default")
