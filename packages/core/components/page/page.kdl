// Lord of the Components - Page Component
// Creates the HTML document structure and auto-includes dependencies

component "page" {
    description "Root page component that creates HTML structure and includes CSS/JS"
    category "layout"
    status "stable"

    props {
        title type="string" required=#true "Page title displayed in browser tab"

        lang type="string" default="en" "HTML language attribute"

        charset type="string" default="utf-8" "Document character encoding"

        description type="string" "Meta description for SEO"

        theme type="string" "Theme name to apply (adds class to body)"

        head type="string" "Additional HTML content for the head section"

        scripts type="array" "Additional script URLs to include"

        styles type="array" "Additional stylesheet URLs to include"
    }

    slots {
        default required=#true "Main page content"
    }

    tokens {
        // Page doesn't use component-specific tokens
        // It relies on global tokens from the theme
    }

    examples {
        example "basic" {
            title "Basic Page"
            description "Simple page with title and content"
            code "<c-page title=\"My Application\"><h1>Welcome</h1><p>This is my application.</p></c-page>"
        }

        example "with-meta" {
            title "Page with Meta"
            description "Page with description and language"
            code "<c-page title=\"About Us\" description=\"Learn more about our company\" lang=\"nl\"><h1>Over Ons</h1><p>Welkom op onze website.</p></c-page>"
        }

        example "with-extras" {
            title "Page with Extra Assets"
            description "Page with additional scripts and styles"
            code "<c-page title=\"Dashboard\" :scripts='[\"/js/charts.js\"]' :styles='[\"/css/dashboard.css\"]'><div id=\"dashboard\"></div></c-page>"
        }

        example "themed" {
            title "Themed Page"
            description "Page with a specific theme applied"
            code "<c-page title=\"Dark Mode\" theme=\"dark\"><h1>Dark Theme</h1><p>This page uses the dark theme.</p></c-page>"
        }
    }
}
