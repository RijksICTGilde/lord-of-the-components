// Lord of the Components - Button Component
// Interactive button for user actions

component "button" {
    description "Interactive button for user actions"
    category "actions"
    status "stable"
    depends-on "icon"

    props {
        variant type="generic-color" default="primary" {
            enum "primary" "secondary" "success" "warning" "error" "ghost"
        }
        "Visual style of the button"

        size type="generic-size" default="md" {
            enum "sm" "md" "lg"
        }
        "Size of the button"

        type type="enum" default="button" {
            enum "button" "submit" "reset"
        }
        "HTML button type attribute"

        disabled type="boolean" default=false "Whether the button is disabled"

        loading type="boolean" default=false "Whether to show loading state"

        icon type="string" "Icon name to display"

        iconPosition type="enum" default="before" {
            enum "before" "after"
        }
        "Position of icon relative to text"

        fullWidth type="boolean" default=false "Whether button spans full width"
    }

    slots {
        default required=true "Button label/content"
    }

    tokens {
        "background" "{color.primary}"
        "background-hover" "{color.primary-hover}"
        "text-color" "{color.on-primary}"
        "border-radius" "{radius.md}"
        "padding-x" "{space.md}"
        "padding-y" "{space.sm}"
    }

    examples {
        example "variants" {
            title "Button Variants"
            description "All available visual styles"
            code ```
                <c-button variant="primary">Primary</c-button>
                <c-button variant="secondary">Secondary</c-button>
                <c-button variant="success">Success</c-button>
                <c-button variant="warning">Warning</c-button>
                <c-button variant="error">Error</c-button>
                <c-button variant="ghost">Ghost</c-button>
            ```
        }

        example "sizes" {
            title "Button Sizes"
            description "Available size options"
            code ```
                <c-button size="sm">Small</c-button>
                <c-button size="md">Medium</c-button>
                <c-button size="lg">Large</c-button>
            ```
        }

        example "with-icons" {
            title "Buttons with Icons"
            description "Icons can be placed before or after text"
            code ```
                <c-button icon="download">Download</c-button>
                <c-button icon="arrow-right" iconPosition="after">Next</c-button>
                <c-button icon="plus" variant="success">Add Item</c-button>
            ```
        }

        example "states" {
            title "Button States"
            description "Disabled and loading states"
            code ```
                <c-button disabled>Disabled</c-button>
                <c-button loading>Loading...</c-button>
            ```
        }

        example "full-width" {
            title "Full Width Button"
            description "Button that spans the full container width"
            code ```
                <c-button fullWidth>Full Width Button</c-button>
            ```
        }

        example "form-submit" {
            title "Form Submit Button"
            description "Button with submit type for forms"
            code ```
                <form>
                    <c-button type="submit" variant="primary">Submit Form</c-button>
                    <c-button type="reset" variant="secondary">Reset</c-button>
                </form>
            ```
        }
    }
}
