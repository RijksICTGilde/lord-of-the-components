# Lord of the Components - Breadcrumb Component Logic
# Breadcrumb navigation showing page hierarchy

render.element("nav"):
    # Base class
    attrs.class = "c-breadcrumb"

    # ARIA attributes for accessibility
    attrs["aria-label"] = "Breadcrumb"

    # Ordered list wrapper for semantic structure
    render.element("ol"):
        attrs.class = "c-breadcrumb__list"

        # Render from items array if provided
        if props.items:
            for index, item in props.items:
                render.element("li"):
                    attrs.class = "c-breadcrumb__item"

                    # Mark last item as current page
                    if index == length(props.items) - 1:
                        attrs["aria-current"] = "page"

                    # Separator (except before first item)
                    if index > 0:
                        render.element("span"):
                            attrs.class = "c-breadcrumb__separator"
                            attrs["aria-hidden"] = "true"
                            render.text(props.separator or "/")

                    # Link or text based on href presence
                    if item.href:
                        render.element("a"):
                            attrs.class = "c-breadcrumb__link"
                            attrs.href = item.href
                            render.text(item.label)
                    else:
                        render.element("span"):
                            attrs.class = "c-breadcrumb__text"
                            render.text(item.label)
        else:
            # Slot-based breadcrumb items
            render.slot("default")
