# Lord of the Components - Empty Component Logic
# Empty state placeholder for no content with optional icon, title, description, and actions

render.element("div"):
    # Build CSS classes array
    let classes = ["c-empty"]

    # Size modifier (default: md)
    if props.size:
        classes = classes + ["c-empty--" + props.size]

    # Apply classes
    attrs.class = join(classes, " ")

    # Icon section (slot or prop)
    if slots.icon:
        render.element("div"):
            attrs.class = "c-empty__icon"
            render.slot("icon")
    elif props.icon:
        render.element("div"):
            attrs.class = "c-empty__icon"
            render.component("icon", name=props.icon)

    # Content wrapper
    render.element("div"):
        attrs.class = "c-empty__content"

        # Title (optional)
        if props.title:
            render.element("h3"):
                attrs.class = "c-empty__title"
                render.text(props.title)

        # Description (optional)
        if props.description:
            render.element("p"):
                attrs.class = "c-empty__description"
                render.text(props.description)

        # Default slot for custom content
        if slots.default:
            render.slot("default")

    # Actions slot (optional)
    if slots.actions:
        render.element("div"):
            attrs.class = "c-empty__actions"
            render.slot("actions")
