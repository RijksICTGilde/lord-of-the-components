# Lord of the Components - Tab Component Logic
# Single tab button within tabs

render.element("button"):
    # Base class
    attrs.class = "c-tabs__tab"

    # ARIA attributes
    attrs.role = "tab"
    attrs.type = "button"
    attrs.id = "tab-" + props.id
    attrs["aria-controls"] = "panel-" + props.id

    # Note: active state is managed by parent tabs component
    # Default to not selected (parent will override when active)
    attrs["aria-selected"] = "false"
    attrs.tabindex = "-1"

    # Disabled state
    if props.disabled:
        attrs.class = attrs.class + " c-tabs__tab--disabled"
        attrs.disabled = true
        attrs["aria-disabled"] = "true"

    # Icon (optional)
    if props.icon:
        render.element("span"):
            attrs.class = "c-tabs__icon"
            render.component("icon", name=props.icon)

    # Label content
    render.element("span"):
        attrs.class = "c-tabs__label"
        render.slot("default")
