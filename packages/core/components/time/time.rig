# Lord of the Components - Time Component Logic
# Formatted time or date display using semantic HTML <time> element

render.element("time"):
    # Build CSS classes array
    let classes = ["c-time"]

    # Format variant class
    let format = props.format or "relative"
    classes = classes + ["c-time--" + format]

    # Apply classes
    attrs.class = join(classes, " ")

    # Required datetime attribute (ISO 8601 format)
    attrs.datetime = props.datetime

    # Show tooltip with full datetime on hover (default: true)
    let showTooltip = props.tooltip
    if showTooltip != false:
        attrs.title = props.datetime

    # Locale data attribute for client-side formatting
    if props.locale:
        attrs["data-locale"] = props.locale

    # Custom format data attribute
    if props.customFormat:
        attrs["data-custom-format"] = props.customFormat

    # Format data attribute for client-side rendering
    attrs["data-format"] = format

    # Render the datetime as initial content (client-side JS will format it)
    render.text(props.datetime)
