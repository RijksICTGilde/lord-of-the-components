# Lord of the Components - Prose Component Logic
# Container for long-form rich text content with typography styling

render.element("div"):
    # Base class
    attrs.class = "c-prose"

    # Size variant (sm, md, lg)
    if props.size:
        attrs.class = attrs.class + " c-prose--size-" + props.size

    # Maximum width (prose, full, none)
    if props.maxWidth:
        attrs.class = attrs.class + " c-prose--max-width-" + props.maxWidth

    # Render rich text content
    render.slot("default")
