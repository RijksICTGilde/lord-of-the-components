# Lord of the Components - Heading Component Logic
# Renders a semantic heading (h1-h6) with optional visual style override

# Determine the HTML tag based on level (h1-h6)
let tag = "h" + props.level

render.element(tag):
    # Visual style class - uses 'as' if provided, otherwise falls back to level
    let visualLevel = props.as or props.level
    attrs.class = "c-heading c-heading--" + visualLevel

    # Size variant
    if props.size:
        attrs.class = attrs.class + " c-heading--size-" + props.size

    # Font weight
    if props.weight:
        attrs.class = attrs.class + " c-heading--weight-" + props.weight

    # Text alignment
    if props.align:
        attrs.class = attrs.class + " c-heading--align-" + props.align

    # Truncation
    if props.truncate:
        attrs.class = attrs.class + " c-heading--truncate"

    # Render heading content
    render.slot("default")
