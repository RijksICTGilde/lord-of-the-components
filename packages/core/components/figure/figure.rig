# Lord of the Components - Figure Component Logic
# Figure with optional caption for images, videos, and other media

render.element("figure"):
    # Build CSS classes array
    let classes = ["c-figure"]

    # Alignment modifier (start, center, end)
    if props.align:
        classes = classes + ["c-figure--align-" + props.align]

    # Apply classes
    attrs.class = join(classes, " ")

    # Caption position determines render order
    let captionPos = props.captionPosition or "bottom"

    # Render caption at top if specified
    if captionPos == "top":
        render.element("figcaption"):
            attrs.class = "c-figure__caption"
            if props.caption:
                render.text(props.caption)
            render.slot("caption")

    # Main content (image, video, etc.)
    render.slot("default")

    # Render caption at bottom (default)
    if captionPos == "bottom":
        render.element("figcaption"):
            attrs.class = "c-figure__caption"
            if props.caption:
                render.text(props.caption)
            render.slot("caption")
