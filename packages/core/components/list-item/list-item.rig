# Lord of the Components - List Item Component Logic
# Individual list item with optional leading/trailing content

# Determine wrapper element (link if href provided, li otherwise)
let tag = props.href ? "a" : "li"

render.element(tag):
    # Link href
    if props.href:
        attrs.href = props.href
        attrs.role = "listitem"

    # Selected state
    if props.selected:
        attrs.selected = true
        attrs["aria-selected"] = true

    # Disabled state
    if props.disabled:
        attrs.disabled = true
        attrs["aria-disabled"] = true

    # Leading slot (icon, avatar, etc.)
    if slots.leading or props.icon:
        render.element("span"):
            attrs.class = "c-list-item__leading"
            if slots.leading:
                render.slot("leading")
            else if props.icon:
                render.component("icon"):
                    attrs.name = props.icon

    # Main content wrapper
    render.element("span"):
        attrs.class = "c-list-item__content"

        # Primary text
        render.element("span"):
            attrs.class = "c-list-item__text"
            render.slot("default")

        # Description (secondary text)
        if slots.description:
            render.element("span"):
                attrs.class = "c-list-item__description"
                render.slot("description")

    # Trailing slot (badge, action, etc.)
    if slots.trailing:
        render.element("span"):
            attrs.class = "c-list-item__trailing"
            render.slot("trailing")
