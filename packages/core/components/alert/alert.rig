# Lord of the Components - Alert Component Logic
# Alert message for important information with optional title, dismiss button, and actions

render.element("div"):
    # Base class with variant modifier
    attrs.class = "c-alert"
    if props.variant:
        attrs.class = attrs.class + " c-alert--" + props.variant

    # ARIA role for accessibility
    attrs.role = "alert"

    # Icon (defaults based on variant, or custom)
    if props.icon:
        render.element("span"):
            attrs.class = "c-alert__icon"
            render.component("icon", name=props.icon)

    # Content wrapper
    render.element("div"):
        attrs.class = "c-alert__content"

        # Title (optional)
        if props.title:
            render.element("div"):
                attrs.class = "c-alert__title"
                render.text(props.title)

        # Message content (default slot)
        render.element("div"):
            attrs.class = "c-alert__message"
            render.slot("default")

    # Actions slot (optional)
    if slots.actions:
        render.element("div"):
            attrs.class = "c-alert__actions"
            render.slot("actions")

    # Dismiss button (optional)
    if props.dismissible:
        render.element("button"):
            attrs.type = "button"
            attrs.class = "c-alert__dismiss"
            attrs["aria-label"] = "Dismiss alert"
            render.component("icon", name="close")
