# Lord of the Components - Tab Panel Component Logic
# Content panel for a tab

render.element("div"):
    # Base class
    attrs.class = "c-tabs__panel"

    # ARIA attributes for accessibility
    attrs.role = "tabpanel"
    attrs.id = "panel-" + props.tabId
    attrs["aria-labelledby"] = "tab-" + props.tabId

    # Allow keyboard focus
    attrs.tabindex = "0"

    # Panel content
    render.slot("default")
