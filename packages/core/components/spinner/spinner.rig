# Lord of the Components - Spinner Component Logic
# Loading spinner indicator with accessible label for screen readers

render.element("div"):
    # Base class
    attrs.class = "c-spinner"

    # Size modifier (default: md)
    if props.size:
        attrs.class = attrs.class + " c-spinner--" + props.size

    # Variant/color modifier (default: primary)
    if props.variant:
        attrs.class = attrs.class + " c-spinner--" + props.variant

    # ARIA attributes for accessibility
    attrs.role = "status"
    attrs["aria-label"] = props.label or "Loading..."

    # Visually hidden text for screen readers
    render.element("span"):
        attrs.class = "c-visually-hidden"
        render.text(props.label or "Loading...")
