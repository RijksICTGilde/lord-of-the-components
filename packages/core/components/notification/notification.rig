# Lord of the Components - Notification Component Logic
# Toast notification for transient messages with optional title, dismiss button, and actions

render.element("div"):
    # Base class with variant modifier
    attrs.class = "c-notification"
    if props.variant:
        attrs.class = attrs.class + " c-notification--" + props.variant

    # Position modifier (for CSS positioning)
    if props.position:
        attrs.class = attrs.class + " c-notification--" + props.position

    # ARIA role for accessibility
    attrs.role = "alert"
    attrs["aria-live"] = "polite"

    # Data attribute for duration (for JavaScript auto-dismiss)
    if props.duration:
        attrs["data-duration"] = props.duration

    # Icon (defaults based on variant, or custom)
    if props.icon:
        render.element("span"):
            attrs.class = "c-notification__icon"
            render.component("icon", name=props.icon)

    # Content wrapper
    render.element("div"):
        attrs.class = "c-notification__content"

        # Title (optional)
        if props.title:
            render.element("div"):
                attrs.class = "c-notification__title"
                render.text(props.title)

        # Message content (default slot)
        render.element("div"):
            attrs.class = "c-notification__message"
            render.slot("default")

    # Actions slot (optional)
    if slots.actions:
        render.element("div"):
            attrs.class = "c-notification__actions"
            render.slot("actions")

    # Dismiss button (optional, default true)
    if props.dismissible:
        render.element("button"):
            attrs.type = "button"
            attrs.class = "c-notification__dismiss"
            attrs["aria-label"] = "Dismiss notification"
            render.component("icon", name="close")
