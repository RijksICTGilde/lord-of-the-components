{% import 'components/_generic_attributes.j2' as attrs %}
{#
  Gauge — a value on a 270° ring, drawn by Chart.js.

  Markup only: the configuration travels as JSON on the canvas and charts.js
  builds the chart from it (once per page, instead of an inline <script> per
  gauge). Colours are NOT in that JSON — charts.js resolves them from the theme,
  so the gauge follows light/dark like everything else.
#}
{% macro lotc_render(_component_context) %}
{% set value = _component_context.get('value', '0') %}
{% set label = _component_context.get('label', '') %}
{% set sublabel = _component_context.get('sublabel', '') %}
{% set cid = _component_context.get('id', 'lotc-gauge') %}
{# No literal default: an unset colour resolves to the theme's accent. #}
{% set color = _component_context.get('color', '') %}
<figure class="lotc-gauge" data-lotc-component="gauge" {{ attrs.render_extra_attributes(_component_context) }}>
  <div class="lotc-gauge__ring">
    <canvas id="{{ cid }}-canvas" data-lotc-gauge="{{ {'value': value, 'color': color} | tojson | forceescape }}"></canvas>
    <div class="lotc-gauge__value"><span class="lotc-gauge__pct">{{ value }}%</span>{% if sublabel %}<span class="lotc-gauge__sub">{{ sublabel }}</span>{% endif %}</div>
  </div>
  {% if label %}<figcaption class="lotc-gauge__label">{{ label }}</figcaption>{% endif %}
</figure>
{% endmacro %}
