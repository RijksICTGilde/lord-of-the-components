{% import 'components/_generic_attributes.j2' as attrs %}
{#
  Line chart with optional request/limit threshold lines, drawn by Chart.js.

  Markup only: the configuration travels as JSON on the canvas and charts.js
  builds the chart from it (once per page, instead of an inline <script> per
  chart). Colours are NOT in that JSON — charts.js resolves grid, ticks, legend
  and the two threshold lines from the theme; Chart.js' own defaults are a fixed
  grey and a fixed black tint, both unreadable on a dark page.
#}
{% macro lotc_render(_component_context) %}
{% set data = _component_context.get('data', {}) %}
{% set cid = _component_context.get('id', 'lotc-chart') %}
{% set height = _component_context.get('height', '220px') %}
{% set legend = _component_context.get('legend', false) %}
{% set title = _component_context.get('title', '') %}
{% set current = _component_context.get('current', '') %}
{% set limit = _component_context.get('limit', '') %}
{% set request = _component_context.get('request', '') %}
{% set config = {'data': data, 'legend': true if legend else false, 'limit': limit, 'request': request} %}
<figure class="lotc-chart" data-lotc-component="line-chart" {{ attrs.render_extra_attributes(_component_context) }}>
  {% if title %}<figcaption class="lotc-chart__title">{{ title }}</figcaption>{% endif %}
  <div class="lotc-chart__canvas" style="height: {{ height }}"><canvas id="{{ cid }}-canvas" data-lotc-line-chart="{{ config | tojson | forceescape }}"></canvas></div>
  {% if current %}<figcaption class="lotc-chart__current">{{ current }}</figcaption>{% endif %}
</figure>
{% endmacro %}
