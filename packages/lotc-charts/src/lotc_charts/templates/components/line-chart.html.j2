{% import 'components/_generic_attributes.j2' as attrs %}
{% macro lotc_render(_component_context) %}
{% set data = _component_context.get('data', {}) %}
{% set cid = _component_context.get('id', 'lotc-chart') %}
{% set height = _component_context.get('height', '220px') %}
{% set legend = _component_context.get('legend', false) %}
{% set title = _component_context.get('title', '') %}
{% set current = _component_context.get('current', '') %}
<figure class="lotc-chart" data-lotc-component="line-chart" {{ attrs.render_extra_attributes(_component_context) }}>
  {% if title %}<figcaption class="lotc-chart__title">{{ title }}</figcaption>{% endif %}
  <div class="lotc-chart__canvas" style="height: {{ height }}"><canvas id="{{ cid }}-canvas"></canvas></div>
  {% if current %}<figcaption class="lotc-chart__current">{{ current }}</figcaption>{% endif %}
</figure>
<script>
(function(){
  var el = document.getElementById({{ (cid ~ '-canvas') | tojson }});
  if (!el || !window.Chart) return;
  new Chart(el, {
    type: 'line',
    data: {{ data | tojson }},
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: {{ 'true' if legend else 'false' }}, labels: { font: { family: 'RijksSans, system-ui, sans-serif' } } } },
      scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,.06)' } } },
      elements: { line: { tension: 0.4, borderWidth: 2 }, point: { radius: 0, hoverRadius: 4 } },
      interaction: { intersect: false, mode: 'index' }
    }
  });
})();
</script>
{% endmacro %}
