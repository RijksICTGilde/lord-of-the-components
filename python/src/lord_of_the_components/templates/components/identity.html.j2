{% import 'components/_generic_attributes.j2' as attrs %}
{# Theme-agnostic identity header: composes c-heading + c-tag + c-icon (the
   status tag routes through c-tag, so no per-theme colour map). The avatar stays
   a theme-neutral initials chip (c-avatar is NLDD-only). #}
{% macro lotc_render(_component_context) %}
{% set name = _component_context.get("name", "") %}
{% set initials = _component_context.get("initials", "") %}
{% set handle = _component_context.get("handle", "") %}
{% set children = _component_context.get("content", "") %}
{% set atag = _component_context.get("aside-tag", "") %}
{% set atype = _component_context.get("aside-tag-type", "warning") %}
{% set asub = _component_context.get("aside-sub", "") %}
{% set alabel = _component_context.get("aside-label", "") %}
{% set ahref = _component_context.get("aside-href", "") %}
<div class="lotc-identity" data-lotc-component="identity" {{ attrs.render_extra_attributes(_component_context) }}>
  <div class="lotc-avatar">{{ initials }}</div>
  <div class="lotc-identity-meta">
    {% if name %}<c-heading type="h4" :label="name"/>{% endif %}
    <div class="lotc-identity-sub">{{ children | safe }}{% if handle %}<span class="lotc-identity-handle"><c-icon icon="chat"/> {{ handle }}</span>{% endif %}</div>
  </div>
  {% if atag or asub or alabel %}<div class="lotc-identity-aside">
    {% if atag %}<c-tag :type="atype" :label="atag"/>{% endif %}
    {% if asub %}<span class="lotc-identity-aside-sub">{{ asub }}</span>{% endif %}
    {% if alabel %}<a{% if ahref %} href="{{ ahref }}"{% endif %} class="lotc-identity-aside-link">{{ alabel }} <c-icon icon="chevron-right"/></a>{% endif %}
  </div>{% endif %}
</div>
{% endmacro %}
