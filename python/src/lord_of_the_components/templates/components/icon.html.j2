{% import 'components/_generic_attributes.j2' as attrs %}
{% import 'components/_attribute_mixin.j2' as attributes %}
{% macro lotc_render(_component_context) %}
{% set icons_map = {'home': 'home', 'settings': 'instellingen', 'notification': 'bel', 'info': 'info', 'favorite': 'favoriet', 'mail': 'mail', 'calendar': 'kalender', 'search': 'zoek', 'apartment-building': 'flat', 'arrow-up-arrow-down': 'gegevensuitwisseling', 'books-vertical': 'boeken-achter-elkaar', 'brackets-ellipsis': 'computercode', 'business-suitcase': 'koffer', 'certificate': 'diploma-certificaat', 'chart-x-y-axis-line': 'grafiek', 'check-list': 'klembord-met-vinkjes-en-lijnen', 'check-mark-circle': 'vinkje', 'chevron-left-forward-slash-chevron-right': 'computercode', 'clipboard': 'klembord-met-lijnen-met-kruis', 'clipboard-rectangle': 'klembord-met-lijnen-met-kruis', 'code': 'computercode', 'cylinder-split': 'database', 'database': 'database', 'envelope': 'mail', 'euro-sign': 'eurobiljetten', 'exclamation-triangle': 'let-op', 'eye': 'oog', 'eyeglasses': 'zoek', 'face-smiling-badge-plus': 'user', 'file-text': 'document-blanco', 'flag': 'vlag-driehoekig', 'folder-stack': 'map-vol-documenten', 'gear': 'instellingen', 'globe': 'wereldbol', 'heart': 'hart', 'house': 'home', 'link': 'interne-link', 'lock-closed': 'hangslot-dicht', 'pencil-on-square': 'bewerken', 'person': 'user', 'person-2': 'personen-arm-op-schouder', 'person-circle': 'user', 'plus': 'plus', 'puzzle-piece': 'puzzel', 'rectangle-stack': 'tegelweergave', 'shield-check-mark': 'schild-met-vinkje-erop', 'ship-wheel': 'stuurwiel', 'sparkles': 'brein', 'square-on-square': 'stapel-kaarten', 'starburst-filled': 'ster', 'sun': 'zon', 'tag': 'label', 'terminal': 'computercode', 'timer': 'klok'} %}
{% set colors_map = {'primary': 'hemelblauw', 'primary-dark': 'donkerblauw', 'muted': 'grijs-700', 'inverse': 'wit', 'hemelblauw': 'hemelblauw', 'donkerblauw': 'donkerblauw', 'logoblauw': 'logoblauw'} %}
{% set slots = _component_context.get('slots', {}) %}
{% set aria_label = _component_context.get('aria-label', '') %}
{% set color = _component_context.get('color', '') %}
{% set icon = _component_context.get('icon', '') %}
{% set size = _component_context.get('size', 'md') %}
{% set css_classes = ['utrecht-icon', 'rvo-icon'] %}
{% if icon %}{% set css_classes = css_classes + ['rvo-icon-' ~ icons_map[icon]] %}{% endif %}
{% if size == '2xs' %}{% set css_classes = css_classes + ['rvo-icon--2xs'] %}{% endif %}
{% if size == 'xs' %}{% set css_classes = css_classes + ['rvo-icon--xs'] %}{% endif %}
{% if size == 'sm' %}{% set css_classes = css_classes + ['rvo-icon--sm'] %}{% endif %}
{% if size == 'md' %}{% set css_classes = css_classes + ['rvo-icon--md'] %}{% endif %}
{% if size == 'lg' %}{% set css_classes = css_classes + ['rvo-icon--lg'] %}{% endif %}
{% if size == 'xl' %}{% set css_classes = css_classes + ['rvo-icon--xl'] %}{% endif %}
{% if size == '2xl' %}{% set css_classes = css_classes + ['rvo-icon--2xl'] %}{% endif %}
{% if size == '3xl' %}{% set css_classes = css_classes + ['rvo-icon--3xl'] %}{% endif %}
{% if size == '4xl' %}{% set css_classes = css_classes + ['rvo-icon--4xl'] %}{% endif %}
{% if color %}{% set css_classes = css_classes + ['rvo-icon--' ~ colors_map[color]] %}{% endif %}
{% set utility_classes = attributes.render_utility_classes(_component_context) %}
{% if utility_classes %}
    {% set css_classes = css_classes + utility_classes.split() %}
{% endif %}
{% if _component_context.get('class') %}
    {% set css_classes = css_classes + _component_context['class'].split() %}
{% endif %}
<span
    class="{{ css_classes | join(' ') }}"
    data-lotc-component="icon"
    role="img"
    aria-label="{{ aria_label }}"
    {{ attrs.render_extra_attributes(_component_context) }}>
</span>
{% endmacro %}
