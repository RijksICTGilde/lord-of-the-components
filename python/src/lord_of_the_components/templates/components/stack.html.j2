{#
  Lord of the Components - Stack Template

  Flexbox-based layout for stacking items with consistent spacing.
#}
{% set ctx = _component_context %}
{% set direction = ctx.direction | default('vertical') %}
{% set gap = ctx.gap | default('md') %}
{% set align = ctx.align | default('stretch') %}
{% set justify = ctx.justify | default('start') %}
{% set wrap = ctx.wrap | default(false) %}
{% set reverse = ctx.reverse | default(false) %}
{% set dividers = ctx.dividers | default(false) %}

{% set classes = ['c-stack', 'c-stack--' ~ direction] %}
{% if dividers %}{% set classes = classes + ['c-stack--dividers'] %}{% endif %}
{% if wrap %}{% set classes = classes + ['c-stack--wrap'] %}{% endif %}
{% if reverse %}{% set classes = classes + ['c-stack--reverse'] %}{% endif %}

{# Map direction to flex-direction #}
{% if direction == 'vertical' %}
    {% set flex_direction = 'column' if not reverse else 'column-reverse' %}
{% else %}
    {% set flex_direction = 'row' if not reverse else 'row-reverse' %}
{% endif %}

{# Map align to align-items #}
{% set align_map = {
    'start': 'flex-start',
    'center': 'center',
    'end': 'flex-end',
    'stretch': 'stretch',
    'baseline': 'baseline'
} %}

{# Map justify to justify-content #}
{% set justify_map = {
    'start': 'flex-start',
    'center': 'center',
    'end': 'flex-end',
    'space-between': 'space-between',
    'space-around': 'space-around',
    'space-evenly': 'space-evenly'
} %}

{% set styles = [
    'display: flex',
    'flex-direction: ' ~ flex_direction,
    'gap: var(--space-' ~ gap ~ ')',
    'align-items: ' ~ align_map[align],
    'justify-content: ' ~ justify_map[justify]
] %}

{% if wrap %}
{% set styles = styles + ['flex-wrap: wrap'] %}
{% endif %}

<div class="{{ classes | join(' ') }}" style="{{ styles | join('; ') }};">
    {{ ctx.content | safe }}
</div>
