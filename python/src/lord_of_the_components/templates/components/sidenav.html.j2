{% import 'components/_generic_attributes.j2' as attrs %}
{# Theme-neutral side navigation wrapper — pure markup, one core template. #}
{% macro lotc_render(_component_context) %}
{% set children = _component_context.get("content", "") %}
{% set extra = _component_context.get("class", "") %}
<nav class="lotc-sidenav{% if extra %} {{ extra }}{% endif %}" data-lotc-component="sidenav" {{ attrs.render_extra_attributes(_component_context) }}><ul>{{ children | safe }}</ul></nav>
{% endmacro %}
