{% import 'components/_generic_attributes.j2' as attrs %}
{% import 'components/_attribute_mixin.j2' as attributes %}
{% set children = _component_context.get('content', '') %}
{% set background_color = _component_context.get('background-color', '') %}
{% set background_image = _component_context.get('background-image', '') %}
{% set full_card_link = _component_context.get('full-card-link', false) %}
{% set href = _component_context.get('href', '') %}
{% set image = _component_context.get('image', '') %}
{% set image_alt = _component_context.get('image-alt', '') %}
{% set image_size = _component_context.get('image-size', 'md') %}
{% set inline_image = _component_context.get('inline-image', false) %}
{% set inverted_colors = _component_context.get('inverted-colors', false) %}
{% set layout = _component_context.get('layout', 'column') %}
{% set outline = _component_context.get('outline', false) %}
{% set padding = _component_context.get('padding', 'md') %}
{% set show_link_indicator = _component_context.get('show-link-indicator', false) %}
{% set title = _component_context.get('title', '') %}
{% set has_link_indicator = show_link_indicator and href and full_card_link %}
{% set css_classes = ['rvo-card'] %}
{% if image and not inline_image %}{% set css_classes = css_classes + ['rvo-card--with-image'] %}{% endif %}
{% if image and image_size and not inline_image %}{% set css_classes = css_classes + ['rvo-card--with-image-' ~ image_size] %}{% endif %}
{% if outline and not background_image %}{% set css_classes = css_classes + ['rvo-card--outline'] %}{% endif %}
{% if (outline or background_color) and padding != 'none' %}{% set css_classes = css_classes + ['rvo-card--padding-' ~ padding] %}{% endif %}
{% if background_image %}{% set css_classes = css_classes + ['rvo-card--with-background-image'] %}{% endif %}
{% if inverted_colors %}{% set css_classes = css_classes + ['rvo-card--inverted-colors'] %}{% endif %}
{% set utility_classes = attributes.render_utility_classes(_component_context) %}
{% if utility_classes %}
    {% set css_classes = css_classes + utility_classes.split() %}
{% endif %}
{% if _component_context.get('class') %}
    {% set css_classes = css_classes + _component_context['class'].split() %}
{% endif %}
<div
    class="{{ css_classes | join(' ') }}"
    data-lotc-component="card"
    {{ attrs.render_extra_attributes(_component_context) }}>
    {% if background_image %}
    <div class="rvo-card__background-image-container">
        <img src="{{ background_image }}" class="rvo-card__background-image" alt="" />
    </div>
    {% endif %}
    {% if image and not inline_image %}
    <div class="rvo-card__image-container{% if layout == 'row' %} rvo-card__image-container--row{% endif %}">
        <img src="{{ image }}" class="rvo-card__image{% if image_size %} rvo-card-img--{{ image_size }}{% endif %}" alt="{{ image_alt }}" />
    </div>
    {% endif %}
    {% if has_link_indicator %}
    <div class="rvo-card--with-link-indicator">
    {% endif %}
        <div class="rvo-card__content{% if layout == 'row' %} rvo-layout-row rvo-layout-align-content-center rvo-layout-gap--md{% endif %}">
            {% if image and inline_image and layout == 'row' %}
            <img src="{{ image }}" class="rvo-card__image{% if image_size %} rvo-card-img--{{ image_size }}{% endif %}" alt="{{ image_alt }}" />
            {% endif %}
            {% if title %}
            <h3 class="utrecht-heading-3">
                {% if href %}<a href="{{ href }}" class="rvo-card__link{% if full_card_link %} rvo-card__full-card-link{% endif %}">{{ title | safe }}</a>{% else %}{{ title | safe }}{% endif %}
            </h3>
            {% endif %}
            {% if children %}{{ children | safe }}{% endif %}
        </div>
        {% if has_link_indicator %}
        <span class="rvo-icon rvo-icon--delta-naar-rechts rvo-icon--sm rvo-card__link-indicator" aria-label="Delta naar rechts" role="img"></span>
        {% endif %}
    {% if has_link_indicator %}
    </div>
    {% endif %}
</div>
