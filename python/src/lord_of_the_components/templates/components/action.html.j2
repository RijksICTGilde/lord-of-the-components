{% import 'components/_generic_attributes.j2' as attrs %}
{# Theme-agnostic action row: composes c-icon; shared lotc-action-* layout.
   Now renders in every theme (was NLDD-only). #}
{% macro lotc_render(_component_context) %}
{% set icon = _component_context.get("icon", "") %}
{% set title = _component_context.get("title", "") %}
{% set sub = _component_context.get("sub", "") %}
{% set tone = _component_context.get("tone", "neutral") %}
{% set children = _component_context.get("content", "") %}
<div class="lotc-action{% if tone != "neutral" %} lotc-action--{{ tone }}{% endif %}" data-lotc-component="action" {{ attrs.render_extra_attributes(_component_context) }}>
  {% if icon %}<c-icon :icon="icon" class="lotc-action-icon"/>{% endif %}
  <div class="lotc-action-body"><div class="lotc-action-title">{{ title }}</div>{% if sub %}<div class="lotc-action-sub">{{ sub }}</div>{% endif %}</div>
  {{ children | safe }}
</div>
{% endmacro %}
