{#
  Lord of the Components - Page Template

  Full HTML document wrapper with head, meta tags, and body content.
  Auto-generated by webpack — CSS/JS links are injected automatically.

  Props:
    - title: Page title (required)
    - lang: HTML language attribute (default: "en")
    - charset: Document charset (default: "utf-8")
    - description: Meta description for SEO
    - theme: Theme name for body class (theme-{value})
    - body-class: Additional classes for body element
    - head: Additional content for <head> section (raw HTML)
    - class: Additional CSS classes (applied to body)
#}
{% set title = _component_context.get('title', '') %}
{% set lang = _component_context.get('lang', 'en') %}
{% set charset = _component_context.get('charset', 'utf-8') %}
{% set description = _component_context.get('description', '') %}
{% set theme = _component_context.get('theme', '') %}
{% set body_class = _component_context.get('body-class', '') %}
{% set head = _component_context.get('head', '') %}
{% set custom_class = _component_context.get('class', '') %}
{% set children = _component_context.get('content', '') %}
{% set css_classes = [] %}
{% if theme %}{% set css_classes = css_classes + ['theme-' ~ theme] %}{% endif %}
{% if body_class %}{% set css_classes = css_classes + body_class.split() %}{% endif %}
{% if custom_class %}{% set css_classes = css_classes + custom_class.split() %}{% endif %}
<!DOCTYPE html>
<html lang="{{ lang }}" data-lotc-component="page">
<head>
    <meta charset="{{ charset }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}
    <% for (const css of htmlWebpackPlugin.files.css) { %>
    <link rel="stylesheet" href="<%= css %>">
    <% } %>
    {% if head %}
    {{ head | safe }}
    {% endif %}
</head>
<body{% if css_classes %} class="{{ css_classes | join(' ') }}"{% endif %}>
{{ children | safe }}
<% for (const js of htmlWebpackPlugin.files.js) { %>
    <% if (js.endsWith(".mjs")) { %>
    <script type="module" src="<%= js %>"></script>
    <% } else { %>
    <script src="<%= js %>"></script>
    <% } %>
<% } %>
</body>
</html>
