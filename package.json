{
  "name": "lord-of-the-components",
  "version": "0.1.0",
  "description": "Implementation-agnostic component system with c- prefixed tagnames",
  "type": "module",
  "private": true,
  "workspaces": [
    "core"
  ],
  "scripts": {
    "build": "npm run build -w core",
    "build:fe": "webpack --config webpack.config.cjs --mode=development",
    "build:fe:nldd": "webpack --config webpack.nldd.cjs",
    "build:fe:watch": "webpack --config webpack.config.cjs --watch --mode=development",
    "dev": "npm run dev -w core",
    "test": "npm run test -w core",
    "test:visual": "npx playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:update": "npx playwright test --config=tests/visual/playwright.config.ts --update-snapshots",
    "lint": "npm run lint -w core",
    "lotc": "node core/dist/cli/index.js",
    "gen:authoring": "node core/src/generators/docs/generate-authoring.mjs",
    "gen:storybook": "node core/src/generators/nldd/generate-storybook.mjs",
    "gen:docs": "npm run gen:icons && npm run gen:authoring && npm run gen:storybook",
    "gen:icons": "npx tsx core/src/generators/icons/generate-icons.ts",
    "gen:nldd": "node core/src/generators/nldd/generate-nldd.mjs",
    "nldd:check": "node core/src/generators/nldd/generate-nldd.mjs --check && node core/src/generators/nldd/extract-assets.mjs --check",
    "nldd:diff": "node core/src/generators/nldd/nldd-diff.mjs",
    "nldd:update": "npm run gen:nldd && npm run gen:nldd-assets && npm run gen:icons && npm run gen:docs",
    "gen:nldd-assets": "node core/src/generators/nldd/extract-assets.mjs"
  },
  "keywords": [
    "components",
    "design-system",
    "jinja2",
    "react",
    "web-components"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@nl-rvo/assets": "1.0.0-alpha.360",
    "@nl-rvo/component-library-css": "4.7.0",
    "@nl-rvo/css-button": "^1.1.5",
    "@nl-rvo/design-tokens": "1.8.0",
    "@nldd/design-system": "0.8.86",
    "reset-css": "^5.0.2"
  }
}
