// Lord of the Components - Default Theme
// Maps semantic tokens to primitives for a clean, modern look

theme "default" {
    description "Default light theme with blue primary color"

    tokens {
        // Color mappings
        color {
            // Brand colors
            primary           "{primitives.colors.blue.500}"
            primary-hover     "{primitives.colors.blue.600}"
            primary-active    "{primitives.colors.blue.700}"
            secondary         "{primitives.colors.gray.200}"
            secondary-hover   "{primitives.colors.gray.300}"
            secondary-active  "{primitives.colors.gray.400}"

            // Foreground on brand
            on-primary        "{primitives.colors.white.DEFAULT}"
            on-secondary      "{primitives.colors.gray.900}"

            // Surface colors
            surface           "{primitives.colors.white.DEFAULT}"
            surface-raised    "{primitives.colors.white.DEFAULT}"
            surface-sunken    "{primitives.colors.gray.50}"
            on-surface        "{primitives.colors.gray.900}"

            // Border colors
            border            "{primitives.colors.gray.200}"
            border-hover      "{primitives.colors.gray.300}"
            border-focus      "{primitives.colors.blue.500}"
            border-strong     "{primitives.colors.gray.400}"

            // Text colors
            text              "{primitives.colors.gray.900}"
            text-secondary    "{primitives.colors.gray.600}"
            text-tertiary     "{primitives.colors.gray.400}"
            text-link         "{primitives.colors.blue.600}"
            text-link-hover   "{primitives.colors.blue.700}"

            // Feedback colors
            success           "{primitives.colors.green.500}"
            success-hover     "{primitives.colors.green.600}"
            on-success        "{primitives.colors.white.DEFAULT}"
            warning           "{primitives.colors.yellow.500}"
            warning-hover     "{primitives.colors.yellow.600}"
            on-warning        "{primitives.colors.gray.900}"
            error             "{primitives.colors.red.500}"
            error-hover       "{primitives.colors.red.600}"
            on-error          "{primitives.colors.white.DEFAULT}"
            info              "{primitives.colors.blue.500}"
            info-hover        "{primitives.colors.blue.600}"
            on-info           "{primitives.colors.white.DEFAULT}"

            // Interactive
            focus-ring        "{primitives.colors.blue.500}"
            disabled          "{primitives.colors.gray.100}"
            on-disabled       "{primitives.colors.gray.400}"
        }

        // Spacing mappings
        space {
            xs   "{primitives.spacing.1}"
            sm   "{primitives.spacing.2}"
            md   "{primitives.spacing.4}"
            lg   "{primitives.spacing.6}"
            xl   "{primitives.spacing.8}"
            "2xl"  "{primitives.spacing.12}"
            "3xl"  "{primitives.spacing.16}"
        }

        // Border radius mappings
        radius {
            sm   "{primitives.radius.sm}"
            md   "{primitives.radius.md}"
            lg   "{primitives.radius.lg}"
            xl   "{primitives.radius.xl}"
            full "{primitives.radius.full}"
        }

        // Typography mappings
        text {
            font-sans  "{primitives.typography.font-family.sans}"
            font-serif "{primitives.typography.font-family.serif}"
            font-mono  "{primitives.typography.font-family.mono}"

            heading-1  "{primitives.typography.font-size.5xl}"
            heading-2  "{primitives.typography.font-size.4xl}"
            heading-3  "{primitives.typography.font-size.3xl}"
            heading-4  "{primitives.typography.font-size.2xl}"
            heading-5  "{primitives.typography.font-size.xl}"
            heading-6  "{primitives.typography.font-size.lg}"

            body-lg    "{primitives.typography.font-size.lg}"
            body       "{primitives.typography.font-size.base}"
            body-sm    "{primitives.typography.font-size.sm}"

            caption    "{primitives.typography.font-size.xs}"
            overline   "{primitives.typography.font-size.xs}"
            label      "{primitives.typography.font-size.sm}"
        }

        // Motion mappings
        motion {
            duration-fast   "{primitives.motion.duration.150}"
            duration-normal "{primitives.motion.duration.300}"
            duration-slow   "{primitives.motion.duration.500}"
            easing-default  "{primitives.motion.easing.ease-in-out}"
            easing-in       "{primitives.motion.easing.ease-in}"
            easing-out      "{primitives.motion.easing.ease-out}"
            easing-in-out   "{primitives.motion.easing.ease-in-out}"
        }

        // Shadow mappings
        shadow {
            sm   "0 1px 2px 0 rgb(0 0 0 / 0.05)"
            md   "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
            lg   "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
            xl   "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
            none "none"
        }

        // Z-index mappings
        z {
            base     "0"
            dropdown "1000"
            sticky   "1100"
            modal    "1200"
            popover  "1300"
            tooltip  "1400"
        }
    }
}
