{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "rootDir": "fe_src/ts",
    "outDir": "./dist/fe",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "fe_src/ts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
