// Lord of the Components - Spacing & Size Primitives
// Base spacing scale and sizing values

spacing {
    // Base spacing scale (4px increments)
    "0" (dimension)"0"
    "px" (dimension)"1px"
    "0.5" (dimension)"0.125rem"  // 2px
    "1" (dimension)"0.25rem"     // 4px
    "1.5" (dimension)"0.375rem"  // 6px
    "2" (dimension)"0.5rem"      // 8px
    "2.5" (dimension)"0.625rem"  // 10px
    "3" (dimension)"0.75rem"     // 12px
    "3.5" (dimension)"0.875rem"  // 14px
    "4" (dimension)"1rem"        // 16px
    "5" (dimension)"1.25rem"     // 20px
    "6" (dimension)"1.5rem"      // 24px
    "7" (dimension)"1.75rem"     // 28px
    "8" (dimension)"2rem"        // 32px
    "9" (dimension)"2.25rem"     // 36px
    "10" (dimension)"2.5rem"     // 40px
    "11" (dimension)"2.75rem"    // 44px
    "12" (dimension)"3rem"       // 48px
    "14" (dimension)"3.5rem"     // 56px
    "16" (dimension)"4rem"       // 64px
    "20" (dimension)"5rem"       // 80px
    "24" (dimension)"6rem"       // 96px
    "28" (dimension)"7rem"       // 112px
    "32" (dimension)"8rem"       // 128px
    "36" (dimension)"9rem"       // 144px
    "40" (dimension)"10rem"      // 160px
    "44" (dimension)"11rem"      // 176px
    "48" (dimension)"12rem"      // 192px
    "52" (dimension)"13rem"      // 208px
    "56" (dimension)"14rem"      // 224px
    "60" (dimension)"15rem"      // 240px
    "64" (dimension)"16rem"      // 256px
    "72" (dimension)"18rem"      // 288px
    "80" (dimension)"20rem"      // 320px
    "96" (dimension)"24rem"      // 384px
}

radius {
    none (dimension)"0"
    sm (dimension)"0.125rem"     // 2px
    DEFAULT (dimension)"0.25rem" // 4px
    md (dimension)"0.375rem"     // 6px
    lg (dimension)"0.5rem"       // 8px
    xl (dimension)"0.75rem"      // 12px
    "2xl" (dimension)"1rem"      // 16px
    "3xl" (dimension)"1.5rem"    // 24px
    full (dimension)"9999px"
}

// Typography
typography {
    font-family {
        sans (font-family)"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
        serif (font-family)"Georgia, Cambria, 'Times New Roman', Times, serif"
        mono (font-family)"'SF Mono', Monaco, 'Cascadia Code', 'Courier New', monospace"
    }

    font-size {
        xs (dimension)"0.75rem"      // 12px
        sm (dimension)"0.875rem"     // 14px
        base (dimension)"1rem"       // 16px
        lg (dimension)"1.125rem"     // 18px
        xl (dimension)"1.25rem"      // 20px
        "2xl" (dimension)"1.5rem"    // 24px
        "3xl" (dimension)"1.875rem"  // 30px
        "4xl" (dimension)"2.25rem"   // 36px
        "5xl" (dimension)"3rem"      // 48px
        "6xl" (dimension)"3.75rem"   // 60px
        "7xl" (dimension)"4.5rem"    // 72px
        "8xl" (dimension)"6rem"      // 96px
        "9xl" (dimension)"8rem"      // 128px
    }

    font-weight {
        thin (font-weight)"100"
        extralight (font-weight)"200"
        light (font-weight)"300"
        normal (font-weight)"400"
        medium (font-weight)"500"
        semibold (font-weight)"600"
        bold (font-weight)"700"
        extrabold (font-weight)"800"
        black (font-weight)"900"
    }

    line-height {
        none (number)"1"
        tight (number)"1.25"
        snug (number)"1.375"
        normal (number)"1.5"
        relaxed (number)"1.625"
        loose (number)"2"
    }
}

// Motion/Animation
motion {
    duration {
        "75" (duration)"75ms"
        "100" (duration)"100ms"
        "150" (duration)"150ms"
        "200" (duration)"200ms"
        "300" (duration)"300ms"
        "500" (duration)"500ms"
        "700" (duration)"700ms"
        "1000" (duration)"1000ms"
    }

    easing {
        linear (string)"linear"
        ease (string)"ease"
        ease-in (string)"ease-in"
        ease-out (string)"ease-out"
        ease-in-out (string)"ease-in-out"
    }
}

// Z-index scale
z-index {
    auto (string)"auto"
    "0" (number)"0"
    "10" (number)"10"
    "20" (number)"20"
    "30" (number)"30"
    "40" (number)"40"
    "50" (number)"50"
}
