// Lord of the Components - Semantic Token Schema
// Defines the vocabulary of design tokens used by components
// These are purpose-driven tokens that get mapped to primitives by themes

semantic {
    // Color semantic tokens
    color {
        // Brand colors
        primary
        primary-hover
        primary-active
        secondary
        secondary-hover
        secondary-active

        // Foreground on brand colors
        on-primary
        on-secondary

        // Surface colors (backgrounds)
        surface
        surface-raised
        surface-sunken
        on-surface

        // Border colors
        border
        border-hover
        border-focus
        border-strong

        // Text colors
        text
        text-secondary
        text-tertiary
        text-link
        text-link-hover

        // Feedback/status colors
        success
        success-hover
        on-success
        warning
        warning-hover
        on-warning
        error
        error-hover
        on-error
        info
        info-hover
        on-info

        // Interactive states
        focus-ring
        disabled
        on-disabled
    }

    // Spacing semantic tokens
    space {
        xs    // Extra small (4px)
        sm    // Small (8px)
        md    // Medium (16px)
        lg    // Large (24px)
        xl    // Extra large (32px)
        "2xl" // 2x large (48px)
        "3xl" // 3x large (64px)
    }

    // Border radius semantic tokens
    radius {
        sm
        md
        lg
        xl
        full
    }

    // Typography semantic tokens
    text {
        font-sans
        font-serif
        font-mono

        // Headings
        heading-1
        heading-2
        heading-3
        heading-4
        heading-5
        heading-6

        // Body text
        body-lg
        body
        body-sm

        // Utility text
        caption
        overline
        label
    }

    // Motion/animation semantic tokens
    motion {
        duration-fast
        duration-normal
        duration-slow
        easing-default
        easing-in
        easing-out
        easing-in-out
    }

    // Shadow semantic tokens
    shadow {
        sm
        md
        lg
        xl
        none
    }

    // Z-index semantic tokens
    z {
        base
        dropdown
        sticky
        modal
        popover
        tooltip
    }
}
