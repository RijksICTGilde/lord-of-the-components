// Lord of the Components - Project Configuration
// This file defines the build configuration for the component system

config {
    // Project metadata
    name "lord-of-the-components"
    version "0.1.0"

    // Output directory for generated files
    output "dist"

    // Default theme to use
    default-theme "default"
}

// Token sources
tokens {
    primitives "tokens/primitives"
    semantic "tokens/semantic"
}

// Theme locations
themes {
    path "themes"
}

// Component packages to include
packages {
    core "packages/core"
    layout "packages/layout"
}

// Generator plugins to run
generators {
    // CSS custom properties from tokens
    generator "tokens/css" {
        output "dist/tokens/tokens.css"
        format "css-custom-properties"
    }

    // JSON token export (for tooling)
    generator "tokens/json" {
        output "dist/tokens/tokens.json"
    }

    // Documentation site
    generator "docs" {
        output "dist/docs"
        include-examples true
    }
}

// Build options
build {
    // Watch mode patterns
    watch {
        include "components/**/*.kdl"
        include "tokens/**/*.kdl"
        include "themes/**/*.kdl"
        include "packages/**/*.kdl"
    }
}
