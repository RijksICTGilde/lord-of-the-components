# Dependencies
node_modules/

# Build output — TypeScript/webpack scratch (NOT the packaged design-system
# bundles under src/**/static/lotc/dist/, which are committed on purpose).
/dist/
core/dist/
build/
*.tsbuildinfo
*.tgz

# Environment / secrets
.env
.env.*

# TypeScript compilation output (in-place builds)
# These directories contain .ts source files; tsc emits .js/.d.ts/.map alongside them
definitions/**/*.js
definitions/**/*.js.map
definitions/**/*.d.ts
definitions/**/*.d.ts.map
implementations/**/*.js
implementations/**/*.js.map
implementations/**/*.d.ts
implementations/**/*.d.ts.map
core/src/generators/jinja2/generate-all.js
core/src/generators/jinja2/generate-all.js.map
core/src/generators/jinja2/generate-all.d.ts
core/src/generators/jinja2/generate-all.d.ts.map
tests/visual/**/*.js
tests/visual/**/*.js.map
tests/visual/**/*.d.ts
tests/visual/**/*.d.ts.map
tests/visual/snapshots/components.spec.js/

# Frontend build output (webpack). These bundles are committed on purpose: they
# ship inside the Python packages so consumers get the full CSS/JS via a plain
# `pip`/`poetry install` and never run npm. Rebuild with `npm run build` and
# commit the result when the frontend changes. (Only local build scratch such as
# source maps is ignored below.)
python/src/lord_of_the_components/static/**/*.map
packages/lotc-rvo/src/lotc_rvo/static/**/*.map
packages/lotc-nldd/src/lotc_nldd/static/**/*.map

# Benchmark output (machine-specific, regenerated per run)
python/benchmarks/results/
python/benchmarks/baseline.json

# IDE
.idea/
*.iml

# macOS
.DS_Store

# Claude settings
.claude/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.coverage
htmlcov/

# Playwright
playwright-report/
test-results/

# Generated compare pages (regenerated by tests/visual/compare.py)
tests/visual/fixtures/_compare-*.html

# Systematic compare harness (regenerated by tests/visual/compare.py)
tests/visual/fixtures/_cmp_*.html
tests/visual/_cmp_manifest.json
screenshots/recreate/*-reference.png
