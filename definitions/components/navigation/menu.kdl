// =============================================================================
// c-menu - Dropdown menu
// =============================================================================

component "menu" {
    description "Dropdown menu for actions or navigation"
    category "navigation"
    status "stable"

    props {
        items type="array" {
            description "Menu items"
            item-shape {
                label "string" required=true
                href "string"
                icon "icon"
                disabled "boolean"
                destructive "boolean"
                divider "boolean"
            }
        }
        open type="boolean" default=false {
            description "Menu open state"
        }
        placement type="placement" default="bottom-start" {
            description "Menu position relative to trigger"
        }
        trigger type="trigger-type" default="click" {
            description "How to open menu"
            values "click" "hover"
        }
    }

    slots {
        trigger required=true {
            description "Menu trigger element"
        }
        default {
            description "Menu items"
        }
    }

    examples {
        example "basic" {
            title "Basic Menu"
            code ```
                <c-menu>
                    <template slot="trigger">
                        <c-button>Options</c-button>
                    </template>

                    <c-menu-item href="/edit" icon="edit">Edit</c-menu-item>
                    <c-menu-item href="/duplicate" icon="copy">Duplicate</c-menu-item>
                    <c-menu-item destructive icon="trash">Delete</c-menu-item>
                </c-menu>
            ```
        }
        example "from-data" {
            title "From Data"
            code ```
                <c-menu :items="menuItems">
                    <template slot="trigger">
                        <c-icon-button icon="more-vertical" ariaLabel="More options" />
                    </template>
                </c-menu>
            ```
        }
    }
}
