// =============================================================================
// c-tabs - Tabbed interface
// =============================================================================

component "tabs" {
    description "Tabbed interface for organizing content"
    category "navigation"
    status "stable"

    props {
        items type="array" {
            description "Tab definitions"
            item-shape {
                id "string" required=true
                label "string" required=true
                icon "icon"
                disabled "boolean"
            }
        }
        activeTab type="string" {
            description "ID of active tab"
        }
        variant type="tabs-variant" default="default" {
            description "Visual variant"
            values "default" "boxed" "pills"
        }
        fitted type="boolean" default=false {
            description "Tabs fill available width"
        }
    }

    slots {
        default {
            description "Tab panels"
        }
    }

    examples {
        example "basic" {
            title "Basic Tabs"
            code ```
                <c-tabs activeTab="profile">
                    <c-tab id="profile">Profile</c-tab>
                    <c-tab id="settings">Settings</c-tab>
                    <c-tab id="billing">Billing</c-tab>

                    <c-tab-panel tabId="profile">
                        Profile content here
                    </c-tab-panel>
                    <c-tab-panel tabId="settings">
                        Settings content here
                    </c-tab-panel>
                    <c-tab-panel tabId="billing">
                        Billing content here
                    </c-tab-panel>
                </c-tabs>
            ```
        }
        example "boxed" {
            title "Boxed Variant"
            code ```
                <c-tabs variant="boxed">
                    <c-tab id="tab1">Tab 1</c-tab>
                    <c-tab id="tab2">Tab 2</c-tab>
                </c-tabs>
            ```
        }
    }
}
