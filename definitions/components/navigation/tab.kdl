// =============================================================================
// c-tab - Single tab button
// =============================================================================

component "tab" {
    description "Single tab button within tabs"
    category "navigation"
    status "stable"

    props {
        id type="string" required=true {
            description "Tab identifier"
        }
        icon type="icon" {
            description "Tab icon"
        }
        disabled type="boolean" default=false {
            description "Disabled state"
        }
    }

    slots {
        default required=true {
            description "Tab label"
        }
    }

    examples {
        example "basic" {
            title "Basic Tab"
            code ```
                <c-tab id="overview">Overview</c-tab>
            ```
        }
        example "with-icon" {
            title "With Icon"
            code ```
                <c-tab id="settings" icon="settings">Settings</c-tab>
            ```
        }
    }
}
