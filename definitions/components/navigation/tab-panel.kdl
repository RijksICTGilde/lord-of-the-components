// =============================================================================
// c-tab-panel - Tab content panel
// =============================================================================

component "tab-panel" {
    description "Content panel for a tab"
    category "navigation"
    status "stable"

    props {
        tabId type="string" required=true {
            description "ID of associated tab"
        }
    }

    slots {
        default required=true {
            description "Panel content"
        }
    }

    examples {
        example "basic" {
            title "Tab Panel"
            code ```
                <c-tab-panel tabId="profile">
                    <h2>Profile</h2>
                    <p>Profile content here...</p>
                </c-tab-panel>
            ```
        }
    }
}
