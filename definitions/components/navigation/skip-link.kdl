// =============================================================================
// c-skip-link - Skip to content link
// =============================================================================

component "skip-link" {
    description "Accessible skip link for keyboard navigation"
    category "navigation"
    status "stable"

    props {
        href type="string" default="#main" {
            description "Target element ID"
        }
    }

    slots {
        default {
            description "Link text (default: 'Skip to main content')"
        }
    }

    examples {
        example "basic" {
            title "Basic Skip Link"
            code ```
                <c-skip-link href="#main-content" />
            ```
        }
        example "custom-text" {
            title "Custom Text"
            code ```
                <c-skip-link href="#main">Skip to content</c-skip-link>
            ```
        }
    }
}
