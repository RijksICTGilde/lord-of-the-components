// =============================================================================
// c-visually-hidden - Screen reader only content
// =============================================================================

component "visually-hidden" {
    description "Content visible only to screen readers"
    category "utility"
    status "stable"

    props {
        focusable type="boolean" default=false {
            description "Becomes visible when focused (skip links)"
        }
    }

    slots {
        default required=true {
            description "Content to hide visually"
        }
    }

    examples {
        example "basic" {
            title "Basic Usage"
            code ```
                <c-button>
                    <c-icon name="search" />
                    <c-visually-hidden>Search</c-visually-hidden>
                </c-button>
            ```
        }
        example "icon-button" {
            title "Icon Button Label"
            code ```
                <button type="button">
                    <c-icon name="menu" />
                    <c-visually-hidden>Open menu</c-visually-hidden>
                </button>
            ```
        }
        example "skip-link" {
            title "Focusable Skip Link"
            code ```
                <c-visually-hidden focusable>
                    <a href="#main-content">Skip to main content</a>
                </c-visually-hidden>
            ```
        }
        example "form-instructions" {
            title "Form Instructions"
            code ```
                <label for="email">
                    Email
                    <c-visually-hidden> (required, must be valid email format)</c-visually-hidden>
                </label>
                <c-input id="email" type="email" required />
            ```
        }
        example "table-caption" {
            title "Table Caption"
            code ```
                <table>
                    <caption>
                        <c-visually-hidden>
                            User accounts sorted by creation date
                        </c-visually-hidden>
                    </caption>
                    <!-- table content -->
                </table>
            ```
        }
    }
}
