// =============================================================================
// c-page - Root page component
// =============================================================================

component "page" {
    description "Bootstrap component that wraps entire HTML page with proper structure"
    category "layout"
    status "stable"

    props {
        title type="string" required=true {
            description "Page title shown in browser tab"
        }
        description type="string" {
            description "Meta description for SEO"
        }
        lang type="string" default="en" {
            description "HTML language attribute"
        }
        charset type="string" default="utf-8" {
            description "Document character encoding"
        }
        theme type="string" {
            description "Theme name to apply"
        }
        bodyClass type="string" {
            description "Additional classes for body element"
        }
    }

    slots {
        default required=true {
            description "Page content"
        }
        head {
            description "Additional content for <head>"
        }
    }

    examples {
        example "basic" {
            title "Basic Page"
            code ```
                <c-page title="My Application">
                    <h1>Welcome</h1>
                    <p>Page content here.</p>
                </c-page>
            ```
        }
        example "with-meta" {
            title "With Meta Description"
            code ```
                <c-page title="About Us" description="Learn more about our company" lang="nl">
                    <c-layout>
                        <h1>Over ons</h1>
                    </c-layout>
                </c-page>
            ```
        }
    }
}
