// =============================================================================
// c-stack - Flexbox stack layout
// =============================================================================

component "stack" {
    description "Flexbox-based stack for vertical or horizontal layouts"
    category "layout"
    status "stable"

    props {
        direction type="direction" default="vertical" {
            description "Stack direction"
            values "horizontal" "vertical"
        }
        gap type="generic-spacing" default="md" {
            description "Space between items"
        }
        align type="align" default="stretch" {
            description "Cross-axis alignment"
            values "start" "center" "end" "stretch" "baseline"
        }
        justify type="justify" default="start" {
            description "Main-axis alignment"
            values "start" "center" "end" "space-between" "space-around" "space-evenly"
        }
        wrap type="boolean" default=false {
            description "Allow items to wrap to next line"
        }
        reverse type="boolean" default=false {
            description "Reverse the order of items"
        }
        dividers type="boolean" default=false {
            description "Show dividers between items"
        }
    }

    slots {
        default required=true {
            description "Stack items"
        }
    }

    examples {
        example "vertical" {
            title "Vertical Stack"
            code ```
                <c-stack gap="lg">
                    <div>Item 1</div>
                    <div>Item 2</div>
                    <div>Item 3</div>
                </c-stack>
            ```
        }
        example "horizontal" {
            title "Horizontal Stack"
            code ```
                <c-stack direction="horizontal" gap="md" align="center">
                    <c-button>Action 1</c-button>
                    <c-button>Action 2</c-button>
                </c-stack>
            ```
        }
        example "with-dividers" {
            title "With Dividers"
            code ```
                <c-stack dividers gap="md">
                    <p>Section 1</p>
                    <p>Section 2</p>
                    <p>Section 3</p>
                </c-stack>
            ```
        }
    }
}
