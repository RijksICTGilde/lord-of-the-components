// =============================================================================
// c-layout - Main page layout with regions
// =============================================================================

component "layout" {
    description "Main page layout container with header, footer, sidebar regions"
    category "layout"
    status "stable"

    props {
        variant type="layout-variant" default="default" {
            description "Layout structure variant"
            values "default" "sidebar-left" "sidebar-right" "holy-grail"
        }
        maxWidth type="container-size" default="lg" {
            description "Maximum width of content area"
        }
        padding type="generic-spacing" default="md" {
            description "Internal padding"
        }
        gap type="generic-spacing" default="md" {
            description "Gap between regions"
        }
        sidebarWidth type="string" default="280px" {
            description "Width of sidebar when present"
        }
    }

    slots {
        default required=true {
            description "Main content area"
        }
        header {
            description "Header region (top)"
        }
        footer {
            description "Footer region (bottom)"
        }
        sidebar {
            description "Sidebar region (position depends on variant)"
        }
        "sidebar-right" {
            description "Right sidebar (for holy-grail layout)"
        }
    }

    examples {
        example "basic" {
            title "Basic Layout"
            code ```
                <c-layout>
                    <p>Main content</p>
                </c-layout>
            ```
        }
        example "with-header-footer" {
            title "Header and Footer"
            code ```
                <c-layout>
                    <template slot="header">
                        <nav>Navigation here</nav>
                    </template>

                    <main>Page content</main>

                    <template slot="footer">
                        <p>© 2024 Company</p>
                    </template>
                </c-layout>
            ```
        }
        example "sidebar" {
            title "With Sidebar"
            code ```
                <c-layout variant="sidebar-left" sidebarWidth="240px">
                    <template slot="sidebar">
                        <nav>Side navigation</nav>
                    </template>

                    <article>Main content</article>
                </c-layout>
            ```
        }
    }
}
