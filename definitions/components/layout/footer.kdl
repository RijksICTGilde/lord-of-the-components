// =============================================================================
// c-footer - Page footer
// =============================================================================

component "footer" {
    description "Page footer section"
    category "layout"
    status "stable"

    props {
        bordered type="boolean" default=true {
            description "Show top border"
        }
        maxWidth type="max-width" {
            description "Content max width"
            values "sm" "md" "lg" "xl" "full"
        }
    }

    slots {
        default {
            description "Footer content"
        }
        nav {
            description "Footer navigation links"
        }
        social {
            description "Social media links"
        }
        legal {
            description "Legal text and links (copyright, terms)"
        }
    }

    examples {
        example "basic" {
            title "Basic Footer"
            code ```
                <c-footer>
                    <template slot="legal">
                        <p>&copy; 2024 Company Name. All rights reserved.</p>
                    </template>
                </c-footer>
            ```
        }
        example "with-nav" {
            title "With Navigation"
            code ```
                <c-footer>
                    <template slot="nav">
                        <div>
                            <h4>Product</h4>
                            <c-link href="/features">Features</c-link>
                            <c-link href="/pricing">Pricing</c-link>
                        </div>
                        <div>
                            <h4>Company</h4>
                            <c-link href="/about">About</c-link>
                            <c-link href="/contact">Contact</c-link>
                        </div>
                    </template>
                    <template slot="legal">
                        <p>&copy; 2024 Company</p>
                    </template>
                </c-footer>
            ```
        }
        example "full" {
            title "Full Footer"
            code ```
                <c-footer maxWidth="lg">
                    <template slot="nav">
                        <!-- Navigation columns -->
                    </template>
                    <template slot="social">
                        <c-icon-button icon="twitter" ariaLabel="Twitter" />
                        <c-icon-button icon="github" ariaLabel="GitHub" />
                        <c-icon-button icon="linkedin" ariaLabel="LinkedIn" />
                    </template>
                    <template slot="legal">
                        <c-link href="/privacy">Privacy Policy</c-link>
                        <c-link href="/terms">Terms of Service</c-link>
                        <p>&copy; 2024 Company Name</p>
                    </template>
                </c-footer>
            ```
        }
    }
}
