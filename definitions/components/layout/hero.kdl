// =============================================================================
// c-hero - Hero section
// =============================================================================

component "hero" {
    description "Hero section for page headers with optional image"
    category "layout"
    status "stable"

    props {
        title type="string" {
            description "Hero title"
        }
        subtitle type="string" {
            description "Hero subtitle"
        }
        size type="generic-size" default="md" {
            description "Hero height"
            values "sm" "md" "lg" "xl"
        }
        image type="object" {
            description "Background image"
            shape {
                src "string" required=true
                alt "string"
            }
        }
        overlay type="boolean" default=false {
            description "Dark overlay on image for text contrast"
        }
        align type="align" default="start" {
            description "Content alignment"
            values "start" "center" "end"
        }
    }

    slots {
        default {
            description "Hero content"
        }
        title {
            description "Custom title content"
        }
        actions {
            description "Call-to-action buttons"
        }
    }

    examples {
        example "basic" {
            title "Basic Hero"
            code ```
                <c-hero
                    title="Welcome to our site"
                    subtitle="Discover amazing features"
                />
            ```
        }
        example "with-image" {
            title "With Background Image"
            code ```
                <c-hero
                    title="Hero Title"
                    subtitle="Supporting text"
                    :image='{"src": "/hero-bg.jpg", "alt": "Hero background"}'
                    overlay
                />
            ```
        }
        example "with-actions" {
            title "With Actions"
            code ```
                <c-hero title="Get Started Today" size="lg" align="center">
                    <template slot="actions">
                        <c-button variant="primary" size="lg">Sign Up</c-button>
                        <c-button variant="secondary" size="lg">Learn More</c-button>
                    </template>
                </c-hero>
            ```
        }
        example "full" {
            title "Full Featured"
            code ```
                <c-hero
                    title="Build Better Software"
                    subtitle="The all-in-one platform for development teams"
                    size="xl"
                    :image='{"src": "/hero.jpg"}'
                    overlay
                    align="center"
                >
                    <p>Start your free trial today - no credit card required.</p>
                    <template slot="actions">
                        <c-button variant="primary">Start Free Trial</c-button>
                    </template>
                </c-hero>
            ```
        }
    }
}
