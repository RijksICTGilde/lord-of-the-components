// =============================================================================
// c-grid-item - Grid item with span control
// =============================================================================

component "grid-item" {
    description "Grid item that can span multiple columns/rows"
    category "layout"
    status "stable"

    props {
        colSpan type="number" default=1 {
            description "Number of columns to span"
        }
        rowSpan type="number" default=1 {
            description "Number of rows to span"
        }
        colStart type="number" {
            description "Starting column (1-based)"
        }
        colEnd type="number" {
            description "Ending column"
        }
        rowStart type="number" {
            description "Starting row (1-based)"
        }
        rowEnd type="number" {
            description "Ending row"
        }
    }

    slots {
        default required=true {
            description "Item content"
        }
    }

    examples {
        example "spanning" {
            title "Spanning Columns"
            code ```
                <c-grid cols="4" gap="md">
                    <c-grid-item colSpan="2">Wide item</c-grid-item>
                    <c-grid-item>Normal</c-grid-item>
                    <c-grid-item>Normal</c-grid-item>
                </c-grid>
            ```
        }
    }
}
