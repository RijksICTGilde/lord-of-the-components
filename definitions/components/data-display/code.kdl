// =============================================================================
// c-code - Inline code
// =============================================================================

component "code" {
    description "Inline code snippet"
    category "data-display"
    status "stable"

    props {
        // No props - just styled inline code
    }

    slots {
        default required=true {
            description "Code text"
        }
    }

    examples {
        example "basic" {
            title "Inline Code"
            code ```
                <p>Use the <c-code>npm install</c-code> command to install dependencies.</p>
            ```
        }
        example "in-text" {
            title "In Text"
            code ```
                <p>The <c-code>useState</c-code> hook is used for state management in React.</p>
            ```
        }
    }
}
