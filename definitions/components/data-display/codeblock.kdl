// =============================================================================
// c-codeblock - Code block with syntax highlighting
// =============================================================================

component "codeblock" {
    description "Code block with optional syntax highlighting"
    category "data-display"
    status "stable"

    props {
        language type="string" {
            description "Programming language for highlighting"
        }
        filename type="string" {
            description "Optional filename display"
        }
        showLineNumbers type="boolean" default=false {
            description "Show line numbers"
        }
        highlightLines type="string" {
            description "Lines to highlight (e.g., '1,3-5,8')"
        }
        copyable type="boolean" default=true {
            description "Show copy button"
        }
        maxHeight type="string" {
            description "Max height with scroll"
        }
    }

    slots {
        default required=true {
            description "Code content"
        }
    }

    examples {
        example "basic" {
            title "Basic Code Block"
            code ```
                <c-codeblock language="javascript">
                    function greet(name) {
                        return `Hello, ${name}!`;
                    }
                </c-codeblock>
            ```
        }
        example "with-filename" {
            title "With Filename"
            code ```
                <c-codeblock language="python" filename="app.py">
                    def main():
                        print("Hello, World!")
                </c-codeblock>
            ```
        }
        example "line-numbers" {
            title "With Line Numbers"
            code ```
                <c-codeblock language="typescript" showLineNumbers>
                    interface User {
                        id: number;
                        name: string;
                        email: string;
                    }
                </c-codeblock>
            ```
        }
        example "highlighted-lines" {
            title "Highlighted Lines"
            code ```
                <c-codeblock language="javascript" showLineNumbers highlightLines="2,4-5">
                    const data = fetch('/api');
                    const json = await data.json(); // highlighted
                    console.log(json);
                    processData(json); // highlighted
                    return json; // highlighted
                </c-codeblock>
            ```
        }
    }
}
