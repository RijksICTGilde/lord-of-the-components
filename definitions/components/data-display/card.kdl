// =============================================================================
// c-card - Content card
// =============================================================================

component "card" {
    description "Card container for grouped content"
    category "data-display"
    status "stable"

    props {
        variant type="card-variant" default="elevated" {
            description "Card style"
            values "elevated" "outlined" "filled"
        }
        padding type="generic-size" default="md" {
            description "Content padding"
            values "none" "sm" "md" "lg"
        }
        href type="string" {
            description "Makes entire card clickable"
        }
        hoverable type="boolean" default=false {
            description "Hover effect"
        }
    }

    slots {
        default required=true {
            description "Card content"
        }
        header {
            description "Card header"
        }
        media {
            description "Media content (image, video)"
        }
        footer {
            description "Card footer"
        }
    }

    examples {
        example "basic" {
            title "Basic Card"
            code ```
                <c-card>
                    <h3>Card Title</h3>
                    <p>Card content goes here.</p>
                </c-card>
            ```
        }
        example "with-header-footer" {
            title "With Header & Footer"
            code ```
                <c-card>
                    <template slot="header">
                        <h3>Card Title</h3>
                    </template>
                    <p>Main content area.</p>
                    <template slot="footer">
                        <c-button variant="primary">Action</c-button>
                    </template>
                </c-card>
            ```
        }
        example "with-media" {
            title "With Media"
            code ```
                <c-card>
                    <template slot="media">
                        <img src="/image.jpg" alt="Description" />
                    </template>
                    <h3>Image Card</h3>
                    <p>Description text.</p>
                </c-card>
            ```
        }
        example "clickable" {
            title "Clickable Card"
            code ```
                <c-card href="/article/123" hoverable>
                    <h3>Article Title</h3>
                    <p>Click to read more...</p>
                </c-card>
            ```
        }
        example "variants" {
            title "Card Variants"
            code ```
                <c-card variant="elevated">Elevated (shadow)</c-card>
                <c-card variant="outlined">Outlined (border)</c-card>
                <c-card variant="filled">Filled (background)</c-card>
            ```
        }
    }
}
