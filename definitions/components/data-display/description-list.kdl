// =============================================================================
// c-description-list - Definition/description list
// =============================================================================

component "description-list" {
    description "Key-value pairs for definitions or metadata"
    category "data-display"
    status "stable"

    props {
        items type="array" {
            description "List items as data"
            item-shape {
                term "string" required=true
                description "string" required=true
            }
        }
        layout type="description-list-layout" default="stacked" {
            description "Layout style"
            values "stacked" "horizontal" "grid"
        }
        columns type="number" default=1 {
            description "Number of columns (for grid layout)"
        }
        striped type="boolean" default=false {
            description "Alternating row colors"
        }
    }

    slots {
        default {
            description "Manual dt/dd pairs"
        }
    }

    examples {
        example "basic" {
            title "Basic Description List"
            code ```
                <c-description-list :items='[
                    {"term": "Name", "description": "John Doe"},
                    {"term": "Email", "description": "john@example.com"},
                    {"term": "Role", "description": "Administrator"}
                ]' />
            ```
        }
        example "horizontal" {
            title "Horizontal Layout"
            code ```
                <c-description-list layout="horizontal" :items='[
                    {"term": "Status", "description": "Active"},
                    {"term": "Created", "description": "Jan 15, 2024"},
                    {"term": "Updated", "description": "Jan 20, 2024"}
                ]' />
            ```
        }
        example "grid" {
            title "Grid Layout"
            code ```
                <c-description-list layout="grid" :columns="2" :items="metadata" />
            ```
        }
        example "manual" {
            title "Manual Composition"
            code ```
                <c-description-list>
                    <dt>Status</dt>
                    <dd><c-badge variant="success">Active</c-badge></dd>
                    <dt>Progress</dt>
                    <dd><c-progress :value="75" /></dd>
                </c-description-list>
            ```
        }
    }
}
