// =============================================================================
// c-figure - Figure with caption
// =============================================================================

component "figure" {
    description "Figure with optional caption"
    category "data-display"
    status "stable"

    props {
        caption type="string" {
            description "Figure caption text"
        }
        captionPosition type="caption-position" default="bottom" {
            description "Caption placement"
            values "top" "bottom"
        }
        align type="align" default="center" {
            description "Figure alignment"
            values "start" "center" "end"
        }
    }

    slots {
        default required=true {
            description "Figure content (image, video, etc.)"
        }
        caption {
            description "Custom caption content"
        }
    }

    examples {
        example "basic" {
            title "Basic Figure"
            code ```
                <c-figure caption="A beautiful sunset">
                    <c-image src="/sunset.jpg" alt="Sunset over the ocean" />
                </c-figure>
            ```
        }
        example "rich-caption" {
            title "Rich Caption"
            code ```
                <c-figure>
                    <c-image src="/chart.png" alt="Sales chart" />
                    <template slot="caption">
                        <strong>Figure 1:</strong> Quarterly sales comparison.
                        <a href="#source">Source</a>
                    </template>
                </c-figure>
            ```
        }
        example "top-caption" {
            title "Top Caption"
            code ```
                <c-figure caption="Product preview" captionPosition="top">
                    <c-image src="/product.jpg" alt="Product" />
                </c-figure>
            ```
        }
    }
}
