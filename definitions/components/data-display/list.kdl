// =============================================================================
// c-list - List container
// =============================================================================

component "list" {
    description "List container for items"
    category "data-display"
    status "stable"

    props {
        variant type="list-variant" default="plain" {
            description "List style"
            values "plain" "divided" "bordered" "card"
        }
        ordered type="boolean" default=false {
            description "Ordered (numbered) list"
        }
        size type="generic-size" default="md" {
            description "Item padding size"
            values "sm" "md" "lg"
        }
        hoverable type="boolean" default=false {
            description "Highlight items on hover"
        }
    }

    slots {
        default required=true {
            description "List items"
        }
    }

    examples {
        example "basic" {
            title "Basic List"
            code ```
                <c-list>
                    <c-list-item>First item</c-list-item>
                    <c-list-item>Second item</c-list-item>
                    <c-list-item>Third item</c-list-item>
                </c-list>
            ```
        }
        example "divided" {
            title "Divided List"
            code ```
                <c-list variant="divided">
                    <c-list-item>Item with separator</c-list-item>
                    <c-list-item>Another item</c-list-item>
                    <c-list-item>Last item</c-list-item>
                </c-list>
            ```
        }
        example "ordered" {
            title "Ordered List"
            code ```
                <c-list ordered>
                    <c-list-item>Step one</c-list-item>
                    <c-list-item>Step two</c-list-item>
                    <c-list-item>Step three</c-list-item>
                </c-list>
            ```
        }
        example "interactive" {
            title "Interactive List"
            code ```
                <c-list variant="bordered" hoverable>
                    <c-list-item href="/item/1">Clickable item</c-list-item>
                    <c-list-item href="/item/2">Another link</c-list-item>
                </c-list>
            ```
        }
    }
}
