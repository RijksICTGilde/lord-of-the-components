// =============================================================================
// c-dropdown - Dropdown container
// =============================================================================

component "dropdown" {
    description "Generic dropdown container"
    category "overlay"
    status "stable"

    props {
        open type="boolean" default=false {
            description "Dropdown visibility"
        }
        placement type="placement" default="bottom-start" {
            description "Position relative to trigger"
        }
        trigger type="trigger-type" default="click" {
            description "How to open dropdown"
            values "click" "hover" "focus" "manual"
        }
        closeOnSelect type="boolean" default=true {
            description "Close when selecting item"
        }
        closeOnClickOutside type="boolean" default=true {
            description "Close when clicking outside"
        }
        matchWidth type="boolean" default=false {
            description "Match trigger width"
        }
    }

    slots {
        trigger required=true {
            description "Trigger element"
        }
        default required=true {
            description "Dropdown content"
        }
    }

    examples {
        example "basic" {
            title "Basic Dropdown"
            code ```
                <c-dropdown>
                    <template slot="trigger">
                        <c-button>
                            Options
                            <c-icon name="chevron-down" />
                        </c-button>
                    </template>
                    <c-menu>
                        <c-menu-item>Option 1</c-menu-item>
                        <c-menu-item>Option 2</c-menu-item>
                        <c-menu-item>Option 3</c-menu-item>
                    </c-menu>
                </c-dropdown>
            ```
        }
        example "custom-content" {
            title "Custom Content"
            code ```
                <c-dropdown>
                    <template slot="trigger">
                        <c-button>Filter</c-button>
                    </template>
                    <div class="p-4">
                        <c-checkbox>Option A</c-checkbox>
                        <c-checkbox>Option B</c-checkbox>
                        <c-checkbox>Option C</c-checkbox>
                        <c-button variant="primary" size="sm">Apply</c-button>
                    </div>
                </c-dropdown>
            ```
        }
        example "hover" {
            title "Hover Trigger"
            code ```
                <c-dropdown trigger="hover">
                    <template slot="trigger">
                        <span>Hover me</span>
                    </template>
                    <c-menu>
                        <c-menu-item>Quick action 1</c-menu-item>
                        <c-menu-item>Quick action 2</c-menu-item>
                    </c-menu>
                </c-dropdown>
            ```
        }
        example "match-width" {
            title "Match Trigger Width"
            code ```
                <c-dropdown matchWidth>
                    <template slot="trigger">
                        <c-button style="width: 200px;">Select option</c-button>
                    </template>
                    <c-list>
                        <c-list-item>Option A</c-list-item>
                        <c-list-item>Option B</c-list-item>
                    </c-list>
                </c-dropdown>
            ```
        }
    }
}
