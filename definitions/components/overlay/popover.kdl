// =============================================================================
// c-popover - Popover content
// =============================================================================

component "popover" {
    description "Popover with rich content"
    category "overlay"
    status "stable"

    props {
        open type="boolean" default=false {
            description "Popover visibility"
        }
        placement type="placement" default="bottom" {
            description "Position relative to trigger"
        }
        trigger type="trigger-type" default="click" {
            description "How to open popover"
            values "click" "hover" "focus" "manual"
        }
        arrow type="boolean" default=true {
            description "Show arrow pointer"
        }
        offset type="number" default=8 {
            description "Distance from trigger"
        }
        closeOnClickOutside type="boolean" default=true {
            description "Close when clicking outside"
        }
    }

    slots {
        trigger required=true {
            description "Element that triggers popover"
        }
        default required=true {
            description "Popover content"
        }
        header {
            description "Popover header"
        }
        footer {
            description "Popover footer"
        }
    }

    examples {
        example "basic" {
            title "Basic Popover"
            code ```
                <c-popover>
                    <template slot="trigger">
                        <c-button>Show Info</c-button>
                    </template>
                    <p>This is additional information.</p>
                </c-popover>
            ```
        }
        example "with-header" {
            title "With Header"
            code ```
                <c-popover>
                    <template slot="trigger">
                        <c-icon-button icon="info" ariaLabel="More info" />
                    </template>
                    <template slot="header">
                        <strong>Details</strong>
                    </template>
                    <p>Here's some detailed information about this feature.</p>
                </c-popover>
            ```
        }
        example "hover" {
            title "Hover Trigger"
            code ```
                <c-popover trigger="hover" placement="top">
                    <template slot="trigger">
                        <span>Hover me</span>
                    </template>
                    <p>Quick preview content</p>
                </c-popover>
            ```
        }
        example "placements" {
            title "Placements"
            code ```
                <c-popover placement="top">...</c-popover>
                <c-popover placement="bottom">...</c-popover>
                <c-popover placement="left">...</c-popover>
                <c-popover placement="right">...</c-popover>
            ```
        }
    }
}
