// =============================================================================
// c-modal - Modal dialog
// =============================================================================

component "modal" {
    description "Modal dialog overlay"
    category "overlay"
    status "stable"

    props {
        open type="boolean" default=false {
            description "Modal visibility"
        }
        title type="string" {
            description "Modal title"
        }
        size type="modal-size" default="md" {
            description "Modal width"
            values "sm" "md" "lg" "xl" "full"
        }
        closeOnOverlay type="boolean" default=true {
            description "Close when clicking overlay"
        }
        closeOnEscape type="boolean" default=true {
            description "Close on Escape key"
        }
        showClose type="boolean" default=true {
            description "Show close button"
        }
        preventScroll type="boolean" default=true {
            description "Prevent body scroll when open"
        }
    }

    slots {
        default required=true {
            description "Modal content"
        }
        header {
            description "Custom header content"
        }
        footer {
            description "Footer with actions"
        }
    }

    examples {
        example "basic" {
            title "Basic Modal"
            code ```
                <c-modal :open="isOpen" title="Confirm Action">
                    <p>Are you sure you want to proceed?</p>
                    <template slot="footer">
                        <c-button variant="secondary" @click="close">Cancel</c-button>
                        <c-button variant="primary" @click="confirm">Confirm</c-button>
                    </template>
                </c-modal>
            ```
        }
        example "sizes" {
            title "Modal Sizes"
            code ```
                <c-modal size="sm" title="Small Modal">...</c-modal>
                <c-modal size="md" title="Medium Modal">...</c-modal>
                <c-modal size="lg" title="Large Modal">...</c-modal>
                <c-modal size="full" title="Fullscreen Modal">...</c-modal>
            ```
        }
        example "form" {
            title "Form Modal"
            code ```
                <c-modal :open="showForm" title="Edit Profile">
                    <c-form>
                        <c-form-field label="Name">
                            <c-input name="name" />
                        </c-form-field>
                        <c-form-field label="Email">
                            <c-input type="email" name="email" />
                        </c-form-field>
                    </c-form>
                    <template slot="footer">
                        <c-button variant="secondary">Cancel</c-button>
                        <c-button variant="primary">Save</c-button>
                    </template>
                </c-modal>
            ```
        }
        example "no-close" {
            title "Persistent Modal"
            code ```
                <c-modal
                    :open="true"
                    title="Required Action"
                    :closeOnOverlay="false"
                    :closeOnEscape="false"
                    :showClose="false"
                >
                    <p>You must complete this action to continue.</p>
                </c-modal>
            ```
        }
    }
}
