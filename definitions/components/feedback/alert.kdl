// =============================================================================
// c-alert - Alert message
// =============================================================================

component "alert" {
    description "Alert message for important information"
    category "feedback"
    status "stable"

    props {
        variant type="alert-variant" default="info" {
            description "Alert type/severity"
            values "info" "success" "warning" "error"
        }
        title type="string" {
            description "Alert title"
        }
        dismissible type="boolean" default=false {
            description "Can be dismissed by user"
        }
        icon type="icon" {
            description "Custom icon (defaults based on variant)"
        }
    }

    slots {
        default required=true {
            description "Alert message content"
        }
        actions {
            description "Action buttons"
        }
    }

    examples {
        example "basic" {
            title "Basic Alert"
            code ```
                <c-alert variant="info">
                    This is an informational message.
                </c-alert>
            ```
        }
        example "variants" {
            title "Alert Variants"
            code ```
                <c-alert variant="success">Operation completed successfully.</c-alert>
                <c-alert variant="warning">Please review before continuing.</c-alert>
                <c-alert variant="error">An error occurred.</c-alert>
            ```
        }
        example "with-title" {
            title "With Title"
            code ```
                <c-alert variant="warning" title="Attention Required">
                    Your session will expire in 5 minutes.
                </c-alert>
            ```
        }
        example "dismissible" {
            title "Dismissible Alert"
            code ```
                <c-alert variant="info" dismissible>
                    You can dismiss this message.
                </c-alert>
            ```
        }
        example "with-actions" {
            title "With Actions"
            code ```
                <c-alert variant="error" title="Connection Lost">
                    Unable to connect to server.
                    <template slot="actions">
                        <c-button size="sm">Retry</c-button>
                    </template>
                </c-alert>
            ```
        }
    }
}
