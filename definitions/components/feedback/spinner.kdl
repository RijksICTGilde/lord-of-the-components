// =============================================================================
// c-spinner - Loading spinner
// =============================================================================

component "spinner" {
    description "Loading spinner indicator"
    category "feedback"
    status "stable"

    props {
        size type="generic-size" default="md" {
            description "Spinner size"
            values "sm" "md" "lg" "xl"
        }
        variant type="generic-color" default="primary" {
            description "Spinner color"
        }
        label type="string" default="Loading..." {
            description "Accessible label (screen reader)"
        }
    }

    slots {
        // No slots
    }

    examples {
        example "basic" {
            title "Basic Spinner"
            code ```
                <c-spinner />
            ```
        }
        example "sizes" {
            title "Spinner Sizes"
            code ```
                <c-spinner size="sm" />
                <c-spinner size="md" />
                <c-spinner size="lg" />
                <c-spinner size="xl" />
            ```
        }
        example "variants" {
            title "Color Variants"
            code ```
                <c-spinner variant="primary" />
                <c-spinner variant="secondary" />
                <c-spinner variant="neutral" />
            ```
        }
        example "with-text" {
            title "With Loading Text"
            code ```
                <div class="flex items-center gap-2">
                    <c-spinner size="sm" />
                    <span>Loading...</span>
                </div>
            ```
        }
        example "button-loading" {
            title "In Button"
            code ```
                <c-button disabled>
                    <c-spinner size="sm" variant="neutral" />
                    Processing...
                </c-button>
            ```
        }
    }
}
