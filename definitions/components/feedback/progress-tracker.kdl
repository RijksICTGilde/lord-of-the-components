// =============================================================================
// c-progress-tracker - Step progress indicator
// =============================================================================

component "progress-tracker" {
    description "Multi-step progress indicator"
    category "feedback"
    status "stable"

    props {
        steps type="array" required=true {
            description "Step definitions"
            item-shape {
                label "string" required=true
                description "string"
                state "step-state"
                href "string"
            }
        }
        currentStep type="number" {
            description "Current step index (0-based)"
        }
        orientation type="orientation" default="horizontal" {
            description "Layout direction"
            values "horizontal" "vertical"
        }
        size type="generic-size" default="md" {
            description "Tracker size"
            values "sm" "md" "lg"
        }
    }

    slots {
        // No slots - driven by data
    }

    examples {
        example "basic" {
            title "Basic Progress Tracker"
            code ```
                <c-progress-tracker :steps='[
                    {"label": "Cart", "state": "complete"},
                    {"label": "Shipping", "state": "current"},
                    {"label": "Payment", "state": "pending"},
                    {"label": "Review", "state": "pending"}
                ]' />
            ```
        }
        example "with-descriptions" {
            title "With Descriptions"
            code ```
                <c-progress-tracker :steps='[
                    {"label": "Account", "description": "Create your account", "state": "complete"},
                    {"label": "Profile", "description": "Add your details", "state": "current"},
                    {"label": "Preferences", "description": "Set your preferences", "state": "pending"}
                ]' />
            ```
        }
        example "vertical" {
            title "Vertical Layout"
            code ```
                <c-progress-tracker orientation="vertical" :steps='[
                    {"label": "Order Placed", "state": "complete"},
                    {"label": "Processing", "state": "complete"},
                    {"label": "Shipped", "state": "current"},
                    {"label": "Delivered", "state": "pending"}
                ]' />
            ```
        }
        example "clickable" {
            title "Clickable Steps"
            code ```
                <c-progress-tracker :steps='[
                    {"label": "Step 1", "state": "complete", "href": "#step1"},
                    {"label": "Step 2", "state": "current", "href": "#step2"},
                    {"label": "Step 3", "state": "pending"}
                ]' />
            ```
        }
    }
}
