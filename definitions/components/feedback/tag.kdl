// =============================================================================
// c-tag - Tag / chip
// =============================================================================

component "tag" {
    description "Tag for categorization or filtering"
    category "feedback"
    status "stable"

    props {
        variant type="generic-color" default="neutral" {
            description "Tag color variant"
        }
        size type="generic-size" default="md" {
            description "Tag size"
            values "sm" "md" "lg"
        }
        removable type="boolean" default=false {
            description "Shows remove button"
        }
        icon type="icon" {
            description "Leading icon"
        }
        disabled type="boolean" default=false {
            description "Disabled state"
        }
    }

    slots {
        default required=true {
            description "Tag label"
        }
    }

    examples {
        example "basic" {
            title "Basic Tag"
            code ```
                <c-tag>Category</c-tag>
            ```
        }
        example "variants" {
            title "Color Variants"
            code ```
                <c-tag variant="primary">Primary</c-tag>
                <c-tag variant="success">Approved</c-tag>
                <c-tag variant="warning">Pending</c-tag>
                <c-tag variant="error">Rejected</c-tag>
            ```
        }
        example "removable" {
            title "Removable Tags"
            code ```
                <c-tag removable>JavaScript</c-tag>
                <c-tag removable>TypeScript</c-tag>
                <c-tag removable>Python</c-tag>
            ```
        }
        example "with-icon" {
            title "With Icon"
            code ```
                <c-tag icon="tag">Label</c-tag>
                <c-tag icon="user" variant="primary">John Doe</c-tag>
            ```
        }
        example "sizes" {
            title "Tag Sizes"
            code ```
                <c-tag size="sm">Small</c-tag>
                <c-tag size="md">Medium</c-tag>
                <c-tag size="lg">Large</c-tag>
            ```
        }
    }
}
