// =============================================================================
// c-notification - Toast notification
// =============================================================================

component "notification" {
    description "Toast notification for transient messages"
    category "feedback"
    status "stable"

    props {
        variant type="alert-variant" default="info" {
            description "Notification type/severity"
            values "info" "success" "warning" "error"
        }
        title type="string" {
            description "Notification title"
        }
        duration type="number" default=5000 {
            description "Auto-dismiss duration in ms (0 = no auto-dismiss)"
        }
        position type="notification-position" default="top-right" {
            description "Screen position"
            values "top-left" "top-center" "top-right" "bottom-left" "bottom-center" "bottom-right"
        }
        dismissible type="boolean" default=true {
            description "Can be dismissed by user"
        }
        icon type="icon" {
            description "Custom icon"
        }
    }

    slots {
        default required=true {
            description "Notification message"
        }
        actions {
            description "Action buttons"
        }
    }

    examples {
        example "basic" {
            title "Basic Notification"
            code ```
                <c-notification variant="success">
                    Changes saved successfully.
                </c-notification>
            ```
        }
        example "with-title" {
            title "With Title"
            code ```
                <c-notification variant="info" title="New Message">
                    You have received a new message from John.
                </c-notification>
            ```
        }
        example "persistent" {
            title "Persistent (No Auto-Dismiss)"
            code ```
                <c-notification variant="warning" :duration="0">
                    Action required: Please verify your email.
                </c-notification>
            ```
        }
        example "with-action" {
            title "With Action"
            code ```
                <c-notification variant="info" title="Update Available">
                    A new version is available.
                    <template slot="actions">
                        <c-button size="sm" variant="ghost">Update Now</c-button>
                    </template>
                </c-notification>
            ```
        }
    }
}
