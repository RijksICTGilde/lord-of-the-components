// =============================================================================
// c-checkbox - Checkbox input
// =============================================================================

component "checkbox" {
    description "Checkbox for boolean selection"
    category "inputs"
    status "stable"

    props {
        label type="string" {
            description "Checkbox label"
        }
        checked type="boolean" default=false {
            description "Checked state"
        }
        value type="any" {
            description "Value when checked"
        }
        name type="string" {
            description "Form field name"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable checkbox"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }
        indeterminate type="boolean" default=false {
            description "Indeterminate state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Checkbox size"
        }

        // Accessibility
        id type="string" {
            description "Checkbox ID"
        }
    }

    slots {
        label {
            description "Custom label content"
        }
        description {
            description "Additional description"
        }
    }

    examples {
        example "basic" {
            title "Basic Checkbox"
            code ```
                <c-checkbox label="I agree to the terms" name="terms" />
            ```
        }
        example "with-description" {
            title "With Description"
            code ```
                <c-checkbox label="Newsletter">
                    <template slot="description">
                        Receive weekly updates about new features
                    </template>
                </c-checkbox>
            ```
        }
        example "states" {
            title "States"
            code ```
                <c-checkbox label="Checked" checked />
                <c-checkbox label="Disabled" disabled />
                <c-checkbox label="Indeterminate" indeterminate />
            ```
        }
    }
}
