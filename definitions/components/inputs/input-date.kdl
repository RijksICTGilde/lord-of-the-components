// =============================================================================
// c-input-date - Date input element
// =============================================================================

component "input-date" {
    description "Date input element"
    category "inputs"
    status "stable"

    props {
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value (YYYY-MM-DD format)"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Input size"
            values "sm" "md" "lg"
        }

        // Validation
        min type="string" {
            description "Minimum date (YYYY-MM-DD)"
        }
        max type="string" {
            description "Maximum date (YYYY-MM-DD)"
        }

        // Accessibility
        id type="string" {
            description "Input ID"
        }
        ariaDescribedby type="string" {
            description "ID of describing element"
        }
    }

    slots {
        // No slots
    }

    examples {
        example "basic" {
            title "Basic Date Input"
            code ```
                <c-input-date name="birthdate" />
            ```
        }
        example "with-range" {
            title "Date Range"
            code ```
                <c-input-date name="appointment" min="2024-01-01" max="2024-12-31" />
            ```
        }
        example "preset-value" {
            title "With Default Value"
            code ```
                <c-input-date name="start_date" value="2024-06-15" />
            ```
        }
    }
}
