// =============================================================================
// c-input-text-field - Complete text input field
// =============================================================================

component "input-text-field" {
    description "Complete text input with label, helper, and error"
    category "inputs"
    status "stable"

    props {
        // Label
        label type="string" required=true {
            description "Field label text"
        }
        required type="boolean" default=false {
            description "Required field (shows indicator)"
        }
        optional type="boolean" default=false {
            description "Optional field (shows indicator)"
        }

        // Input
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value"
        }
        placeholder type="string" {
            description "Placeholder text"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Field size"
            values "sm" "md" "lg"
        }

        // Help text
        helper type="string" {
            description "Helper text below input"
        }
        error type="string" {
            description "Error message (shows when invalid)"
        }

        // Validation
        maxLength type="number" {
            description "Maximum character length"
        }
        minLength type="number" {
            description "Minimum character length"
        }
        pattern type="string" {
            description "Validation regex pattern"
        }

        // Accessibility
        id type="string" {
            description "Input ID (auto-generated if not provided)"
        }
        autocomplete type="autocomplete" {
            description "Autocomplete hint"
        }
    }

    slots {
        helper {
            description "Custom helper content"
        }
        error {
            description "Custom error content"
        }
    }

    examples {
        example "basic" {
            title "Basic Text Field"
            code ```
                <c-input-text-field
                    label="Username"
                    name="username"
                    placeholder="Enter username"
                />
            ```
        }
        example "with-helper" {
            title "With Helper Text"
            code ```
                <c-input-text-field
                    label="Username"
                    name="username"
                    helper="Choose a unique username (3-20 characters)"
                    required
                />
            ```
        }
        example "with-error" {
            title "With Error"
            code ```
                <c-input-text-field
                    label="Username"
                    name="username"
                    value="ab"
                    invalid
                    error="Username must be at least 3 characters"
                />
            ```
        }
        example "full" {
            title "Full Example"
            code ```
                <c-input-text-field
                    label="Display name"
                    name="display_name"
                    placeholder="How should we call you?"
                    helper="This will be shown publicly"
                    required
                    :maxLength="50"
                />
            ```
        }
    }
}
