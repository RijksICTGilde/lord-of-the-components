// =============================================================================
// c-form - Form container
// =============================================================================

component "form" {
    description "Form container with submit handling"
    category "inputs"
    status "stable"

    props {
        // Behavior
        action type="string" {
            description "Form action URL"
        }
        method type="string" default="post" {
            description "HTTP method"
            values "get" "post"
        }
        enctype type="string" {
            description "Form encoding type"
            values "application/x-www-form-urlencoded" "multipart/form-data" "text/plain"
        }
        novalidate type="boolean" default=false {
            description "Disable browser validation"
        }

        // State
        loading type="boolean" default=false {
            description "Form is submitting"
        }

        // Layout
        gap type="generic-spacing" default="md" {
            description "Gap between form elements"
        }
    }

    slots {
        default required=true {
            description "Form content"
        }
        actions {
            description "Form action buttons"
        }
    }

    examples {
        example "basic" {
            title "Basic Form"
            code ```
                <c-form action="/submit" method="post">
                    <c-form-field label="Name" required>
                        <c-input name="name" />
                    </c-form-field>

                    <c-form-field label="Email" required>
                        <c-input name="email" inputType="email" />
                    </c-form-field>

                    <template slot="actions">
                        <c-button type="submit" variant="primary">Submit</c-button>
                        <c-button type="reset" variant="secondary">Reset</c-button>
                    </template>
                </c-form>
            ```
        }
        example "with-loading" {
            title "Loading State"
            code ```
                <c-form :loading="isSubmitting">
                    <!-- Form fields -->
                    <template slot="actions">
                        <c-button type="submit" :loading="isSubmitting">
                            Submit
                        </c-button>
                    </template>
                </c-form>
            ```
        }
    }
}
