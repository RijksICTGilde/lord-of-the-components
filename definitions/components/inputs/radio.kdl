// =============================================================================
// c-radio - Radio button
// =============================================================================

component "radio" {
    description "Radio button for single selection within a group"
    category "inputs"
    status "stable"

    props {
        label type="string" {
            description "Radio label"
        }
        checked type="boolean" default=false {
            description "Checked state"
        }
        value type="any" required=true {
            description "Value when selected"
        }
        name type="string" required=true {
            description "Group name (required for radio)"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable radio"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Radio size"
        }

        // Accessibility
        id type="string" {
            description "Radio ID"
        }
    }

    slots {
        label {
            description "Custom label content"
        }
        description {
            description "Additional description"
        }
    }

    examples {
        example "basic" {
            title "Basic Radio"
            code ```
                <c-radio label="Option A" name="choice" value="a" />
                <c-radio label="Option B" name="choice" value="b" />
                <c-radio label="Option C" name="choice" value="c" />
            ```
        }
    }
}
