// =============================================================================
// c-input-email-field - Complete email input field
// =============================================================================

component "input-email-field" {
    description "Complete email input with label, helper, and error"
    category "inputs"
    status "stable"

    props {
        // Label
        label type="string" required=true {
            description "Field label text"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        optional type="boolean" default=false {
            description "Optional field"
        }

        // Input
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value"
        }
        placeholder type="string" default="email@example.com" {
            description "Placeholder text"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Field size"
        }

        // Help text
        helper type="string" {
            description "Helper text"
        }
        error type="string" {
            description "Error message"
        }

        // Accessibility
        id type="string" {
            description "Input ID"
        }
    }

    slots {
        helper {
            description "Custom helper content"
        }
        error {
            description "Custom error content"
        }
    }

    examples {
        example "basic" {
            title "Basic Email Field"
            code ```
                <c-input-email-field
                    label="Email address"
                    name="email"
                    required
                />
            ```
        }
        example "with-helper" {
            title "With Helper"
            code ```
                <c-input-email-field
                    label="Email address"
                    name="email"
                    helper="We'll never share your email with anyone"
                    required
                />
            ```
        }
        example "with-error" {
            title "With Error"
            code ```
                <c-input-email-field
                    label="Email address"
                    name="email"
                    value="invalid-email"
                    invalid
                    error="Please enter a valid email address"
                />
            ```
        }
    }
}
