// =============================================================================
// c-field-label - Form field label
// =============================================================================

component "field-label" {
    description "Label element for form inputs"
    category "inputs"
    status "stable"

    props {
        for type="string" {
            description "ID of the associated input element"
        }
        required type="boolean" default=false {
            description "Show required indicator"
        }
        optional type="boolean" default=false {
            description "Show optional indicator"
        }
        size type="generic-size" default="md" {
            description "Label text size"
            values "sm" "md" "lg"
        }
    }

    slots {
        default required=true {
            description "Label text"
        }
    }

    examples {
        example "basic" {
            title "Basic Label"
            code ```
                <c-field-label for="username">Username</c-field-label>
                <c-input-text id="username" name="username" />
            ```
        }
        example "required" {
            title "Required Field"
            code ```
                <c-field-label for="email" required>Email address</c-field-label>
                <c-input-email id="email" name="email" required />
            ```
        }
        example "optional" {
            title "Optional Field"
            code ```
                <c-field-label for="phone" optional>Phone number</c-field-label>
                <c-input-text id="phone" name="phone" />
            ```
        }
    }
}
