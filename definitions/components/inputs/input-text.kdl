// =============================================================================
// c-input-text - Text input element
// =============================================================================

component "input-text" {
    description "Single-line text input element"
    category "inputs"
    status "stable"

    props {
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value"
        }
        placeholder type="string" {
            description "Placeholder text"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Input size"
            values "sm" "md" "lg"
        }

        // Validation
        maxLength type="number" {
            description "Maximum character length"
        }
        minLength type="number" {
            description "Minimum character length"
        }
        pattern type="string" {
            description "Validation regex pattern"
        }

        // Accessibility
        id type="string" {
            description "Input ID (for label association)"
        }
        ariaDescribedby type="string" {
            description "ID of describing element"
        }
        autofocus type="boolean" default=false {
            description "Focus on mount"
        }
        autocomplete type="autocomplete" {
            description "Autocomplete hint"
        }
    }

    slots {
        // No slots - raw input element
    }

    examples {
        example "basic" {
            title "Basic Text Input"
            code ```
                <c-input-text name="username" placeholder="Enter username" />
            ```
        }
        example "with-label" {
            title "With Separate Label"
            code ```
                <c-field-label for="email">Email</c-field-label>
                <c-input-text id="email" name="email" placeholder="you@example.com" />
            ```
        }
        example "states" {
            title "States"
            code ```
                <c-input-text disabled value="Cannot edit" />
                <c-input-text readonly value="Read only" />
                <c-input-text invalid value="Bad value" />
            ```
        }
        example "sizes" {
            title "Sizes"
            code ```
                <c-input-text size="sm" placeholder="Small" />
                <c-input-text size="md" placeholder="Medium" />
                <c-input-text size="lg" placeholder="Large" />
            ```
        }
    }
}
