// =============================================================================
// c-input-password-field - Complete password input field
// =============================================================================

component "input-password-field" {
    description "Complete password input with label, helper, and error"
    category "inputs"
    status "stable"

    props {
        // Label
        label type="string" required=true {
            description "Field label text"
        }
        required type="boolean" default=false {
            description "Required field"
        }

        // Input
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value"
        }
        placeholder type="string" {
            description "Placeholder text"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Field size"
        }
        showToggle type="boolean" default=true {
            description "Show visibility toggle"
        }

        // Help text
        helper type="string" {
            description "Helper text"
        }
        error type="string" {
            description "Error message"
        }

        // Validation
        minLength type="number" {
            description "Minimum character length"
        }
        pattern type="string" {
            description "Validation regex pattern"
        }

        // Accessibility
        id type="string" {
            description "Input ID"
        }
        autocomplete type="autocomplete" default="current-password" {
            description "Autocomplete hint"
        }
    }

    slots {
        helper {
            description "Custom helper content"
        }
        error {
            description "Custom error content"
        }
    }

    examples {
        example "basic" {
            title "Basic Password Field"
            code ```
                <c-input-password-field
                    label="Password"
                    name="password"
                    required
                />
            ```
        }
        example "with-requirements" {
            title "With Requirements"
            code ```
                <c-input-password-field
                    label="Password"
                    name="password"
                    helper="Must be 8+ characters with a number and symbol"
                    :minLength="8"
                    required
                />
            ```
        }
        example "new-password" {
            title "New Password"
            code ```
                <c-input-password-field
                    label="Create password"
                    name="new_password"
                    autocomplete="new-password"
                    required
                />
            ```
        }
        example "confirm" {
            title "Confirm Password"
            code ```
                <c-input-password-field
                    label="Confirm password"
                    name="confirm_password"
                    autocomplete="new-password"
                    required
                />
            ```
        }
    }
}
