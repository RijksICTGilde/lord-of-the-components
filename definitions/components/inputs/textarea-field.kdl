// =============================================================================
// c-textarea-field - Complete textarea field
// =============================================================================

component "textarea-field" {
    description "Complete textarea with label, helper, and error"
    category "inputs"
    status "stable"

    props {
        // Label
        label type="string" required=true {
            description "Field label text"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        optional type="boolean" default=false {
            description "Optional field"
        }

        // Textarea
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value"
        }
        placeholder type="string" {
            description "Placeholder text"
        }
        rows type="number" default=4 {
            description "Visible rows"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable textarea"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Field size"
        }
        resize type="resize" default="vertical" {
            description "Resize behavior"
            values "none" "vertical" "horizontal" "both"
        }

        // Validation
        maxLength type="number" {
            description "Maximum character length"
        }
        minLength type="number" {
            description "Minimum character length"
        }
        showCount type="boolean" default=false {
            description "Show character count"
        }

        // Help text
        helper type="string" {
            description "Helper text"
        }
        error type="string" {
            description "Error message"
        }

        // Accessibility
        id type="string" {
            description "Textarea ID"
        }
    }

    slots {
        helper {
            description "Custom helper content"
        }
        error {
            description "Custom error content"
        }
    }

    examples {
        example "basic" {
            title "Basic Textarea Field"
            code ```
                <c-textarea-field
                    label="Description"
                    name="description"
                    placeholder="Enter description..."
                />
            ```
        }
        example "with-count" {
            title "With Character Count"
            code ```
                <c-textarea-field
                    label="Bio"
                    name="bio"
                    :maxLength="500"
                    showCount
                    helper="Brief description about yourself"
                />
            ```
        }
        example "required" {
            title "Required"
            code ```
                <c-textarea-field
                    label="Comments"
                    name="comments"
                    required
                    :rows="6"
                />
            ```
        }
    }
}
