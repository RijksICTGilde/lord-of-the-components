// =============================================================================
// c-input-password - Password input element
// =============================================================================

component "input-password" {
    description "Password input element with optional visibility toggle"
    category "inputs"
    status "stable"

    props {
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value"
        }
        placeholder type="string" {
            description "Placeholder text"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Input size"
            values "sm" "md" "lg"
        }
        showToggle type="boolean" default=true {
            description "Show visibility toggle button"
        }

        // Validation
        maxLength type="number" {
            description "Maximum character length"
        }
        minLength type="number" {
            description "Minimum character length"
        }
        pattern type="string" {
            description "Validation regex pattern"
        }

        // Accessibility
        id type="string" {
            description "Input ID"
        }
        ariaDescribedby type="string" {
            description "ID of describing element"
        }
        autocomplete type="autocomplete" default="current-password" {
            description "Autocomplete hint"
        }
    }

    slots {
        // No slots
    }

    examples {
        example "basic" {
            title "Basic Password Input"
            code ```
                <c-input-password name="password" placeholder="Enter password" />
            ```
        }
        example "no-toggle" {
            title "Without Visibility Toggle"
            code ```
                <c-input-password name="password" :showToggle="false" />
            ```
        }
        example "new-password" {
            title "New Password (autocomplete)"
            code ```
                <c-input-password name="new_password" autocomplete="new-password" />
            ```
        }
    }
}
