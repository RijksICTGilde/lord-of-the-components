// =============================================================================
// c-checkbox-group - Group of checkboxes
// =============================================================================

component "checkbox-group" {
    description "Group of related checkboxes"
    category "inputs"
    status "stable"

    props {
        label type="string" {
            description "Group label (legend)"
        }
        options type="array" {
            description "Available options"
            item-shape {
                label "string" required=true
                value "any" required=true
                disabled "boolean"
                description "string"
            }
        }
        value type="array" {
            description "Selected values"
        }
        name type="string" {
            description "Form field name"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable all checkboxes"
        }
        required type="boolean" default=false {
            description "At least one required"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Layout
        direction type="direction" default="vertical" {
            description "Layout direction"
        }
        gap type="generic-spacing" default="sm" {
            description "Gap between items"
        }
    }

    slots {
        helper {
            description "Helper text"
        }
        error {
            description "Error message"
        }
    }

    examples {
        example "basic" {
            title "Basic Checkbox Group"
            code ```
                <c-checkbox-group
                    label="Interests"
                    :options="[
                        {label: 'Sports', value: 'sports'},
                        {label: 'Music', value: 'music'},
                        {label: 'Travel', value: 'travel'}
                    ]"
                />
            ```
        }
        example "horizontal" {
            title "Horizontal Layout"
            code ```
                <c-checkbox-group
                    label="Sizes"
                    direction="horizontal"
                    :options="[
                        {label: 'S', value: 's'},
                        {label: 'M', value: 'm'},
                        {label: 'L', value: 'l'},
                        {label: 'XL', value: 'xl'}
                    ]"
                />
            ```
        }
    }
}
