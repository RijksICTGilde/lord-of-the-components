// =============================================================================
// c-switch - Toggle switch
// =============================================================================

component "switch" {
    description "Toggle switch for on/off states"
    category "inputs"
    status "stable"

    props {
        label type="string" {
            description "Switch label"
        }
        checked type="boolean" default=false {
            description "On/off state"
        }
        name type="string" {
            description "Form field name"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable switch"
        }

        // Labels
        onLabel type="string" {
            description "Label when on (e.g., 'Yes')"
        }
        offLabel type="string" {
            description "Label when off (e.g., 'No')"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Switch size"
        }

        // Accessibility
        id type="string" {
            description "Switch ID"
        }
    }

    slots {
        label {
            description "Custom label content"
        }
    }

    examples {
        example "basic" {
            title "Basic Switch"
            code ```
                <c-switch label="Enable notifications" />
            ```
        }
        example "with-labels" {
            title "With On/Off Labels"
            code ```
                <c-switch label="Dark mode" onLabel="On" offLabel="Off" />
            ```
        }
        example "sizes" {
            title "Sizes"
            code ```
                <c-switch size="sm" label="Small" />
                <c-switch size="md" label="Medium" />
                <c-switch size="lg" label="Large" />
            ```
        }
    }
}
