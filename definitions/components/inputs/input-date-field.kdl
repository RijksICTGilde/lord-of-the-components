// =============================================================================
// c-input-date-field - Complete date input field
// =============================================================================

component "input-date-field" {
    description "Complete date input with label, helper, and error"
    category "inputs"
    status "stable"

    props {
        // Label
        label type="string" required=true {
            description "Field label text"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        optional type="boolean" default=false {
            description "Optional field"
        }

        // Input
        name type="string" {
            description "Form field name"
        }
        value type="string" {
            description "Current value (YYYY-MM-DD)"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Field size"
        }

        // Validation
        min type="string" {
            description "Minimum date"
        }
        max type="string" {
            description "Maximum date"
        }

        // Help text
        helper type="string" {
            description "Helper text"
        }
        error type="string" {
            description "Error message"
        }

        // Accessibility
        id type="string" {
            description "Input ID"
        }
    }

    slots {
        helper {
            description "Custom helper content"
        }
        error {
            description "Custom error content"
        }
    }

    examples {
        example "basic" {
            title "Basic Date Field"
            code ```
                <c-input-date-field
                    label="Date of birth"
                    name="dob"
                    required
                />
            ```
        }
        example "with-range" {
            title "With Date Range"
            code ```
                <c-input-date-field
                    label="Appointment date"
                    name="appointment"
                    min="2024-01-01"
                    max="2024-12-31"
                    helper="Select a date in 2024"
                />
            ```
        }
    }
}
