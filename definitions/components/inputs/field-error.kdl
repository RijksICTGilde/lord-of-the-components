// =============================================================================
// c-field-error - Form field error message
// =============================================================================

component "field-error" {
    description "Error message for form validation"
    category "inputs"
    status "stable"

    props {
        id type="string" {
            description "ID for aria-describedby association"
        }
        icon type="icon" default="alert-circle" {
            description "Error icon"
        }
        showIcon type="boolean" default=true {
            description "Show error icon"
        }
    }

    slots {
        default required=true {
            description "Error message text"
        }
    }

    examples {
        example "basic" {
            title "Basic Error"
            code ```
                <c-field-label for="email">Email</c-field-label>
                <c-input-email id="email" invalid ariaDescribedby="email-error" />
                <c-field-error id="email-error">
                    Please enter a valid email address
                </c-field-error>
            ```
        }
        example "no-icon" {
            title "Without Icon"
            code ```
                <c-field-error :showIcon="false">
                    This field is required
                </c-field-error>
            ```
        }
        example "multiple-errors" {
            title "Multiple Errors"
            code ```
                <c-field-error>Password must be at least 8 characters</c-field-error>
                <c-field-error>Password must contain a number</c-field-error>
            ```
        }
    }
}
