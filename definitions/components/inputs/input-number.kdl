// =============================================================================
// c-input-number - Number input element
// =============================================================================

component "input-number" {
    description "Numeric input element"
    category "inputs"
    status "stable"

    props {
        name type="string" {
            description "Form field name"
        }
        value type="number" {
            description "Current value"
        }
        placeholder type="string" {
            description "Placeholder text"
        }

        // State
        disabled type="boolean" default=false {
            description "Disable input"
        }
        readonly type="boolean" default=false {
            description "Read-only mode"
        }
        required type="boolean" default=false {
            description "Required field"
        }
        invalid type="boolean" default=false {
            description "Invalid state"
        }

        // Appearance
        size type="generic-size" default="md" {
            description "Input size"
            values "sm" "md" "lg"
        }

        // Validation
        min type="number" {
            description "Minimum value"
        }
        max type="number" {
            description "Maximum value"
        }
        step type="number" default=1 {
            description "Step increment"
        }

        // Accessibility
        id type="string" {
            description "Input ID"
        }
        ariaDescribedby type="string" {
            description "ID of describing element"
        }
    }

    slots {
        // No slots
    }

    examples {
        example "basic" {
            title "Basic Number Input"
            code ```
                <c-input-number name="quantity" placeholder="0" />
            ```
        }
        example "with-range" {
            title "With Min/Max"
            code ```
                <c-input-number name="age" :min="0" :max="120" />
            ```
        }
        example "decimal" {
            title "Decimal Step"
            code ```
                <c-input-number name="price" :min="0" :step="0.01" placeholder="0.00" />
            ```
        }
    }
}
