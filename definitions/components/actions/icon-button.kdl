// =============================================================================
// c-icon-button - Button with only icon
// =============================================================================

component "icon-button" {
    description "Button displaying only an icon (requires aria-label)"
    category "actions"
    status "stable"

    props {
        icon type="icon" required=true {
            description "Icon to display"
        }
        ariaLabel type="string" required=true {
            description "Accessible label (required for icon-only buttons)"
        }
        variant type="generic-color" default="neutral" {
            description "Visual style variant"
        }
        size type="generic-size" default="md" {
            description "Button size"
        }
        disabled type="boolean" default=false {
            description "Disable the button"
        }
        href type="string" {
            description "Link URL (renders as <a>)"
        }
        target type="link-target" default="_self" {
            description "Link target"
        }
        rounded type="boolean" default=true {
            description "Circular shape"
        }
    }

    slots {
        // No slots - icon only
    }

    examples {
        example "basic" {
            title "Basic Icon Buttons"
            code ```
                <c-icon-button icon="edit" ariaLabel="Edit item" />
                <c-icon-button icon="trash" ariaLabel="Delete item" variant="error" />
                <c-icon-button icon="settings" ariaLabel="Settings" />
            ```
        }
        example "sizes" {
            title "Sizes"
            code ```
                <c-icon-button icon="plus" ariaLabel="Add" size="sm" />
                <c-icon-button icon="plus" ariaLabel="Add" size="md" />
                <c-icon-button icon="plus" ariaLabel="Add" size="lg" />
            ```
        }
        example "as-link" {
            title "As Link"
            code ```
                <c-icon-button icon="external-link" ariaLabel="Open in new tab" href="https://example.com" target="_blank" />
            ```
        }
    }
}
