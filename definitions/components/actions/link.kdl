// =============================================================================
// c-link - Text link
// =============================================================================

component "link" {
    description "Text link for navigation"
    category "actions"
    status "stable"

    props {
        href type="string" required=true {
            description "Link destination URL"
        }
        target type="link-target" default="_self" {
            description "Link target"
            values "_self" "_blank" "_parent" "_top"
        }
        disabled type="boolean" default=false {
            description "Disable the link"
        }
        external type="boolean" default=false {
            description "Show external link icon"
        }
        underline type="underline-style" default="hover" {
            description "Underline behavior"
            values "always" "hover" "none"
        }
        icon type="icon" {
            description "Icon to display"
        }
        iconPosition type="icon-position" default="before" {
            description "Position of icon"
        }
    }

    slots {
        default required=true {
            description "Link text"
        }
    }

    examples {
        example "basic" {
            title "Basic Link"
            code ```
                <c-link href="/about">About Us</c-link>
            ```
        }
        example "external" {
            title "External Link"
            code ```
                <c-link href="https://example.com" target="_blank" external>
                    Visit Example.com
                </c-link>
            ```
        }
        example "with-icon" {
            title "With Icon"
            code ```
                <c-link href="/docs" icon="book">Documentation</c-link>
            ```
        }
        example "underline-styles" {
            title "Underline Styles"
            code ```
                <c-link href="#" underline="always">Always underlined</c-link>
                <c-link href="#" underline="hover">Underline on hover</c-link>
                <c-link href="#" underline="none">No underline</c-link>
            ```
        }
    }
}
