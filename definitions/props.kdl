// =============================================================================
// LORD OF THE COMPONENTS - PROP DEFINITIONS
// =============================================================================
// Central definition of all props with their types and allowed values.
// Components reference these props by name.
// =============================================================================

// -----------------------------------------------------------------------------
// GENERIC TYPES (Implementation-specific values)
// -----------------------------------------------------------------------------

type "generic-size" {
    description "Size scale used across components"
    values "xs" "sm" "md" "lg" "xl" "2xl" "3xl"
    default "md"
}

type "generic-color" {
    description "Semantic color variants"
    values "primary" "secondary" "success" "warning" "error" "info" "neutral"
    default "primary"
}

type "generic-spacing" {
    description "Spacing scale for gaps, padding, margins"
    values "none" "xs" "sm" "md" "lg" "xl" "2xl" "3xl"
    default "md"
}

// -----------------------------------------------------------------------------
// FIXED ENUM TYPES
// -----------------------------------------------------------------------------

type "direction" {
    values "horizontal" "vertical"
    default "vertical"
}

type "align" {
    description "Cross-axis alignment"
    values "start" "center" "end" "stretch" "baseline"
    default "stretch"
}

type "justify" {
    description "Main-axis alignment"
    values "start" "center" "end" "space-between" "space-around" "space-evenly"
    default "start"
}

type "button-type" {
    values "button" "submit" "reset"
    default "button"
}

type "input-type" {
    values "text" "email" "password" "tel" "url" "search" "number" "date" "time" "datetime-local"
    default "text"
}

type "link-target" {
    values "_self" "_blank" "_parent" "_top"
    default "_self"
}

type "position" {
    values "top" "bottom" "left" "right"
    default "bottom"
}

type "placement" {
    values "top" "top-start" "top-end" "bottom" "bottom-start" "bottom-end" "left" "left-start" "left-end" "right" "right-start" "right-end"
    default "bottom"
}

type "icon-position" {
    values "before" "after"
    default "before"
}

type "text-align" {
    values "left" "center" "right" "justify"
    default "left"
}

type "font-weight" {
    values "normal" "medium" "semibold" "bold"
    default "normal"
}

type "object-fit" {
    values "cover" "contain" "fill" "none" "scale-down"
    default "cover"
}

type "loading-strategy" {
    values "eager" "lazy"
    default "lazy"
}

type "resize" {
    values "none" "vertical" "horizontal" "both"
    default "vertical"
}

type "autocomplete" {
    values "off" "on" "name" "email" "username" "current-password" "new-password" "tel" "address-line1" "address-line2" "postal-code" "country"
    default "off"
}

type "step-state" {
    values "pending" "current" "complete" "error"
    default "pending"
}

type "heading-level" {
    values "1" "2" "3" "4" "5" "6"
    default "2"
}

type "container-size" {
    values "sm" "md" "lg" "xl" "2xl" "full"
    default "lg"
}

type "modal-size" {
    values "sm" "md" "lg" "xl" "full"
    default "md"
}

type "layout-variant" {
    values "default" "sidebar-left" "sidebar-right" "holy-grail"
    default "default"
}

type "card-variant" {
    values "default" "outlined" "elevated"
    default "default"
}

type "list-variant" {
    values "default" "bordered" "divided"
    default "default"
}

type "nav-variant" {
    values "default" "pills" "underline"
    default "default"
}

type "tabs-variant" {
    values "default" "boxed" "pills"
    default "default"
}

type "avatar-shape" {
    values "circle" "square" "rounded"
    default "circle"
}

type "underline-style" {
    values "always" "hover" "none"
    default "hover"
}

type "trigger-type" {
    values "click" "hover" "focus"
    default "click"
}

type "image-position" {
    values "top" "left" "right" "bottom"
    default "top"
}

type "caption-position" {
    values "below" "above" "overlay"
    default "below"
}

// -----------------------------------------------------------------------------
// IMPLEMENTATION-SPECIFIC TYPES (Theme provides values)
// -----------------------------------------------------------------------------

type "icon" {
    description "Icon name - values provided by theme's icon set"
    implementation-specific true
    // Examples: "home", "user", "settings", "arrow-right", "check", "x"
}

type "color-token" {
    description "Color token reference - values provided by theme"
    implementation-specific true
    // Examples: "blue-500", "gray-900", "brand-primary"
}

// -----------------------------------------------------------------------------
// PROP DEFINITIONS
// -----------------------------------------------------------------------------

// === Styling Props ===

prop "variant" {
    type "generic-color"
    description "Visual style variant that determines the component's color scheme"
}

prop "size" {
    type "generic-size"
    description "Size of the component"
}

prop "color" {
    type "generic-color"
    description "Explicit color (when variant isn't appropriate)"
}

// === State Props ===

prop "disabled" {
    type "boolean"
    default false
    description "Prevents user interaction and shows disabled visual state"
}

prop "loading" {
    type "boolean"
    default false
    description "Shows loading indicator and may disable interaction"
}

prop "readonly" {
    type "boolean"
    default false
    description "Allows viewing but not editing the value"
}

prop "required" {
    type "boolean"
    default false
    description "Marks field as required for form submission"
}

prop "invalid" {
    type "boolean"
    default false
    description "Indicates validation error state"
}

prop "checked" {
    type "boolean"
    default false
    description "Whether the item is selected/checked"
}

prop "open" {
    type "boolean"
    default false
    description "Whether the component is expanded/open"
}

prop "active" {
    type "boolean"
    default false
    description "Whether the item is currently active/selected"
}

prop "selected" {
    type "boolean"
    default false
    description "Whether the item is selected in a list/grid"
}

prop "indeterminate" {
    type "boolean"
    default false
    description "Checkbox indeterminate state (partially selected)"
}

// === Content Props ===

prop "label" {
    type "string"
    description "Text label for the component"
}

prop "placeholder" {
    type "string"
    description "Placeholder text when empty"
}

prop "value" {
    type "any"
    description "Current value of the input"
}

prop "name" {
    type "string"
    description "Form field name for submission"
}

prop "title" {
    type "string"
    description "Title text (heading)"
}

prop "description" {
    type "string"
    description "Descriptive/helper text"
}

prop "icon" {
    type "icon"
    description "Icon name to display"
}

prop "iconPosition" {
    type "icon-position"
    description "Position of icon relative to content"
}

prop "src" {
    type "string"
    description "Source URL for media"
}

prop "alt" {
    type "string"
    description "Alternative text for accessibility"
}

prop "href" {
    type "string"
    description "Link destination URL"
}

prop "content" {
    type "string"
    description "Text content (for tooltip, etc.)"
}

// === Layout Props ===

prop "direction" {
    type "direction"
    description "Layout direction"
}

prop "gap" {
    type "generic-spacing"
    description "Spacing between child elements"
}

prop "align" {
    type "align"
    description "Cross-axis alignment"
}

prop "justify" {
    type "justify"
    description "Main-axis alignment"
}

prop "wrap" {
    type "boolean"
    default false
    description "Whether items wrap to next line"
}

prop "cols" {
    type "number"
    description "Number of columns"
}

prop "rows" {
    type "number"
    description "Number of rows"
}

prop "span" {
    type "number"
    default 1
    description "Number of columns/rows to span"
}

prop "colSpan" {
    type "number"
    description "Number of columns to span"
}

prop "rowSpan" {
    type "number"
    description "Number of rows to span"
}

prop "fullWidth" {
    type "boolean"
    default false
    description "Stretch to full container width"
}

prop "padding" {
    type "generic-spacing"
    description "Internal padding"
}

prop "maxWidth" {
    type "container-size"
    description "Maximum width constraint"
}

// === Behavior Props ===

prop "type" {
    type "string"
    description "HTML type or behavior variant"
}

prop "target" {
    type "link-target"
    description "Link target behavior"
}

prop "closable" {
    type "boolean"
    default false
    description "Shows close button"
}

prop "dismissible" {
    type "boolean"
    default false
    description "Can be dismissed by user"
}

prop "autofocus" {
    type "boolean"
    default false
    description "Focus on mount"
}

prop "autocomplete" {
    type "autocomplete"
    description "Browser autocomplete hint"
}

// === Accessibility Props ===

prop "id" {
    type "string"
    description "Unique identifier for label association"
}

prop "ariaLabel" {
    type "string"
    description "Accessible label when visual label isn't sufficient"
}

prop "ariaDescribedby" {
    type "string"
    description "ID of element that describes this component"
}

prop "role" {
    type "string"
    description "ARIA role override"
}

// === Data Props ===

prop "items" {
    type "array"
    description "Array of items to render"
    item-shape {
        label "string" required=true
        value "any"
        href "string"
        icon "icon"
        disabled "boolean"
        children "array"
    }
}

prop "columns" {
    type "array"
    description "Table column definitions"
    item-shape {
        key "string" required=true
        label "string"
        sortable "boolean"
        width "string"
    }
}

prop "options" {
    type "array"
    description "Available options to choose from"
    item-shape {
        label "string" required=true
        value "any" required=true
        disabled "boolean"
    }
}

prop "steps" {
    type "array"
    description "Progress/wizard steps"
    item-shape {
        label "string" required=true
        description "string"
        state "step-state"
        href "string"
    }
}
